////////////////////////////////////////////////////////////////////////////////
// Форма разблокировки приложения: PIN и биометрия.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВведённыйПИН = "";
	ТекстОшибки = "";
	РазрешитьЗакрытие = Ложь;
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	БиометрияДоступна = ОбщийМодульКлиент_Безопасность.БиометрияПоддерживается()
		И ОбщийМодульСервер_Безопасность.БиометрияВключена();
	ОбновитьHTMLНаСервере();
	
	Если БиометрияДоступна Тогда
		
		ПодключитьОбработчикОжидания("ЗапуститьБиометриюОтложенно", 0.3, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если РазрешитьЗакрытие Или ЗавершениеРаботы Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// Нельзя обойти PIN: закрытие окна запрещено до успешной разблокировки.
	Отказ = Истина;
	ТекстОшибки = "Введите PIN-код для продолжения работы.";
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Команда = ИзвлечьКоманду(ДанныеСобытия.Href);
	
	Если Не ЗначениеЗаполнено(Команда) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если СтрДлина(Команда) = 1 И СтрНайти("0123456789", Команда) > 0 Тогда
		
		Если СтрДлина(ВведённыйПИН) < 6 Тогда
			
			ВведённыйПИН = ВведённыйПИН + Команда;
			ТекстОшибки = "";
			ОбновитьHTMLНаСервере();
			
		КонецЕсли;
		
		Если СтрДлина(ВведённыйПИН) = 6 Тогда
			
			ПопыткаРазблокировкиПИН();
			
		КонецЕсли;
		
	ИначеЕсли Команда = "del" Тогда
		
		Если СтрДлина(ВведённыйПИН) > 0 Тогда
			
			ВведённыйПИН = Лев(ВведённыйПИН, СтрДлина(ВведённыйПИН) - 1);
			ТекстОшибки = "";
			ОбновитьHTMLНаСервере();
			
		КонецЕсли;
		
	ИначеЕсли Команда = "ok" Тогда
		
		ПопыткаРазблокировкиПИН();
		
	ИначеЕсли Команда = "bio" Тогда
		
		ЗапуститьБиометриюОтложенно();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапуститьБиометриюОтложенно() Экспорт
	
	Оповещение = Новый ОписаниеОповещения("ПослеБиометрии", ЭтотОбъект);
	ОбщийМодульКлиент_Безопасность.НачатьБиометрическуюПроверку(Оповещение, "Разблокируйте Wallet");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеБиометрии(ОтмененоПользователем, ДополнительныеПараметры) Экспорт
	
	Если ОтмененоПользователем = Истина Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЗавершитьУспешнуюРазблокировку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПопыткаРазблокировкиПИН()
	
	Результат = ОбщийМодульСервер_Безопасность.ПроверитьПИН(ВведённыйПИН);
	
	Если Не Результат.Успех Тогда
		
		ТекстОшибки = Результат.Текст;
		ВведённыйПИН = "";
		ОбновитьHTMLНаСервере();
		Возврат;
		
	КонецЕсли;
	
	ЗавершитьУспешнуюРазблокировку();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьУспешнуюРазблокировку()
	
	ОбщийМодульКлиент_Безопасность.УстановитьПриложениеРазблокировано(Истина);
	РазрешитьЗакрытие = Истина;
	Оповестить("WalletРазблокирован");
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьКоманду(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Текст = Строка(Ссылка);
	Маркер = "app:";
	Позиция = СтрНайти(НРег(Текст), Маркер);
	
	Если Позиция = 0 Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат Сред(Текст, Позиция + СтрДлина(Маркер));
	
КонецФункции

&НаСервере
Процедура ОбновитьHTMLНаСервере()
	
	Маска = "";
	
	Для Индекс = 1 По СтрДлина(ВведённыйПИН) Цикл
		
		Маска = Маска + "●";
		
	КонецЦикла;
	
	Пока СтрДлина(Маска) < 4 Цикл
		
		Маска = Маска + "○";
		
	КонецЦикла;
	
	Строки = Новый Массив;
	Строки.Добавить("<!DOCTYPE html><html lang=""ru""><head><meta charset=""utf-8"">");
	Строки.Добавить("<meta name=""viewport"" content=""width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"">");
	Строки.Добавить("<style>");
	Строки.Добавить("*{box-sizing:border-box;margin:0;padding:0}");
	Строки.Добавить("body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;background:#F8FAFC;color:#0F172A;padding:28px 20px;text-align:center}");
	Строки.Добавить("h1{font-size:22px;font-weight:700;margin-bottom:8px}");
	Строки.Добавить(".lead{color:#64748B;font-size:14px;margin-bottom:20px}");
	Строки.Добавить(".pin{font-size:28px;letter-spacing:10px;margin:16px 0 8px;min-height:36px}");
	Строки.Добавить(".err{color:#DC2626;font-size:13px;min-height:18px;margin-bottom:12px}");
	Строки.Добавить(".pad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:280px;margin:0 auto}");
	Строки.Добавить(".pad a{display:flex;align-items:center;justify-content:center;height:56px;border-radius:14px;background:#fff;border:1px solid #E2E8F0;font-size:22px;font-weight:600;color:#0F172A;text-decoration:none}");
	Строки.Добавить(".bio{display:inline-block;margin-top:18px;padding:12px 18px;border-radius:12px;background:#EFF6FF;color:#2563EB;font-weight:600;text-decoration:none}");
	Строки.Добавить("</style></head><body>");
	Строки.Добавить("<h1>Wallet</h1>");
	Строки.Добавить("<div class=""lead"">Введите PIN-код</div>");
	Строки.Добавить("<div class=""pin"">" + Маска + "</div>");
	Строки.Добавить("<div class=""err"">" + ЭкранироватьHTML(ТекстОшибки) + "</div>");
	Строки.Добавить("<div class=""pad"">");
	
	Для Цифра = 1 По 9 Цикл
		
		Строки.Добавить("<a href=""app:" + Строка(Цифра) + """>" + Строка(Цифра) + "</a>");
		
	КонецЦикла;
	
	Строки.Добавить("<a href=""app:del"">⌫</a>");
	Строки.Добавить("<a href=""app:0"">0</a>");
	Строки.Добавить("<a href=""app:ok"">OK</a>");
	Строки.Добавить("</div>");
	
	Если БиометрияДоступна Тогда
		
		Строки.Добавить("<a class=""bio"" href=""app:bio"">Войти по биометрии</a>");
		
	КонецЕсли;
	
	Строки.Добавить("</body></html>");
	ТекстHTML = СтрСоединить(Строки, "");
	
КонецПроцедуры

&НаСервере
Функция ЭкранироватьHTML(Знач Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
