&НаКлиенте
Процедура ПодключитьGoogleНативно()
	
	Результат = ОбщийМодульКлиент_GoogleSignIn.НачатьНативныйВход();
	
	Если Результат.Успех Тогда
		
		СтатусСообщения = Результат.Текст;
		ОбновитьHTMLНаСервере();
		Возврат;
		
	КонецЕсли;
	
	// Компоненты в сборке ещё нет — системный picker недоступен, сразу Device Code в браузере.
	ПодключитьGoogleЧерезКод();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьGoogleЧерезКод()
	
	Если Не ClientSecretЗаданНаСервере() Тогда
		
		ПоказатьПредупреждение(,
			"Сначала укажите Google OAuth Client Secret (кнопка на экране резервного копирования). Без него Google возвращает invalid_request после входа в браузере.");
		УказатьClientSecret();
		Возврат;
		
	КонецЕсли;
	
	Результат = НачатьАвторизациюНаСервере();
	
	Если Не Результат.Успех Тогда
		
		ПоказатьПредупреждение(, Результат.Текст);
		СтатусСообщения = Результат.Текст;
		ОбновитьHTMLНаСервере();
		Возврат;
		
	КонецЕсли;
	
	DeviceCode = Результат.DeviceCode;
	ИнтервалОпроса = Результат.Interval;
	СтатусСообщения = Результат.UserCode;
	РежимЭкрана = "auth-wait";
	ОбновитьHTMLНаСервере();
	
	ПерейтиПоНавигационнойСсылке(Результат.VerificationUrl);
	
КонецПроцедуры

