////////////////////////////////////////////////////////////////////////////////
// Форма резервного копирования: локальный файл и Google Drive / Gmail.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимЭкрана = "main";
	ИнтервалОпроса = 5;
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия <> "WalletGoogleSignIn" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	РежимЭкрана = "main";
	СтатусСообщения = Параметр.Текст;
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	КомандаПриложения = ИзвлечьКомандуИзСсылки(ДанныеСобытия.Href);
	
	Если Не ЗначениеЗаполнено(КомандаПриложения) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если КомандаПриложения = "close" Тогда
		
		Закрыть();
		
	ИначеЕсли КомандаПриложения = "backup-local" Тогда
		
		СоздатьЛокальнуюКопию();
		
	ИначеЕсли КомандаПриложения = "choose-backup-folder" Тогда
		
		ВыбратьКаталогЛокальныхКопий(Ложь);
		
	ИначеЕсли КомандаПриложения = "backup-cloud" Тогда
		
		СоздатьОблачнуюКопию();
		
	ИначеЕсли КомандаПриложения = "restore-local" Тогда
		
		ВосстановитьИзЛокальногоФайла();
		
	ИначеЕсли КомандаПриложения = "restore-cloud" Тогда
		
		ПоказатьСписокКопийDrive();
		
	ИначеЕсли КомандаПриложения = "connect-google" Тогда
		
		ПодключитьGoogleНативно();
		
	ИначеЕсли КомандаПриложения = "connect-google-fallback" Тогда
		
		ПодключитьGoogleЧерезКод();
		
	ИначеЕсли КомандаПриложения = "disconnect-google" Тогда
		
		ОтключитьGoogle();
		
	ИначеЕсли КомандаПриложения = "set-email" Тогда
		
		УказатьEmailВручную();
		
	ИначеЕсли КомандаПриложения = "set-client-id" Тогда
		
		УказатьClientId();
		
	ИначеЕсли КомандаПриложения = "set-client-secret" Тогда
		
		УказатьClientSecret();
		
	ИначеЕсли КомандаПриложения = "poll-auth" Тогда
		
		ПроверитьОжиданиеАвторизации();
		
	ИначеЕсли КомандаПриложения = "back-main" Тогда
		
		РежимЭкрана = "main";
		СтатусСообщения = "";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли СтрНачинаетсяС(КомандаПриложения, "restore-drive:") Тогда
		
		ИдентификаторФайла = Сред(КомандаПриложения, СтрДлина("restore-drive:") + 1);
		ВосстановитьИзDriveСПодтверждением(ИдентификаторФайла);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьHTMLНаСервере()
	
	Если РежимЭкрана = "drive-list" Тогда
		
		ТекстHTML = СобратьHTMLСпискаDrive();
		
	ИначеЕсли РежимЭкрана = "auth-wait" Тогда
		
		ТекстHTML = СобратьHTMLОжиданияАвторизации();
		
	Иначе
		
		ТекстHTML = СобратьHTMLГлавногоЭкрана();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СобратьHTMLГлавногоЭкрана()
	
	Сведения = ОбщийМодульСервер_РезервноеКопирование.СведенияОРезервномКопировании();
	
	Аккаунт = ?(ЗначениеЗаполнено(Сведения.Email), ЭкранироватьHTML(Сведения.Email), "не подключён");
	Локальная = ФорматДатыКопии(Сведения.ДатаЛокальнойКопии);
	Облачная = ФорматДатыКопии(Сведения.ДатаОблачнойКопии);
	КаталогКопий = ?(ЗначениеЗаполнено(Сведения.КаталогЛокальныхКопий),
		ЭкранироватьHTML(Сведения.КаталогЛокальныхКопий), "не выбран");
	СтатусБлок = "";
	
	Если ЗначениеЗаполнено(СтатусСообщения) Тогда
		
		СтатусБлок = "<div class=""status"">" + ЭкранироватьHTML(СтатусСообщения) + "</div>";
		
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить("<!DOCTYPE html><html lang=""ru""><head><meta charset=""utf-8"">");
	Строки.Добавить("<meta name=""viewport"" content=""width=device-width, initial-scale=1, maximum-scale=1"">");
	Строки.Добавить("<style>");
	Строки.Добавить("body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;margin:0;padding:16px;background:#F8FAFC;color:#111827}");
	Строки.Добавить("h1{font-size:22px;font-weight:700;margin:0 0 14px}");
	Строки.Добавить(".card{background:#fff;border:1px solid #E5E7EB;border-radius:16px;padding:12px 14px;margin-bottom:12px}");
	Строки.Добавить(".row{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid #F3F4F6}");
	Строки.Добавить(".row:first-child{border-top:none}");
	Строки.Добавить(".lbl{color:#6B7280;font-size:13px;flex-shrink:0}.val{font-size:13px;font-weight:600;text-align:right;word-break:break-all}");
	Строки.Добавить(".btn{display:block;text-decoration:none;text-align:center;border-radius:12px;padding:12px;margin:8px 0;font-weight:600;font-size:15px}");
	Строки.Добавить(".btn.primary{background:#2563EB;color:#fff}");
	Строки.Добавить(".btn.secondary{background:#EFF6FF;color:#1D4ED8}");
	Строки.Добавить(".btn.danger{background:#FEF2F2;color:#DC2626}");
	Строки.Добавить(".btn.muted{background:#F3F4F6;color:#374151}");
	Строки.Добавить(".btn-google{display:flex;align-items:center;justify-content:center;gap:10px;text-decoration:none;");
	Строки.Добавить("background:#fff;border:1px solid #DADCE0;border-radius:12px;padding:12px;margin:8px 0;");
	Строки.Добавить("font-weight:600;font-size:15px;color:#3C4043;box-shadow:0 1px 2px rgba(60,64,67,.15)}");
	Строки.Добавить(".btn-google .g-icon{width:20px;height:20px;display:inline-flex}");
	Строки.Добавить(".status{background:#ECFDF5;border:1px solid #A7F3D0;color:#065F46;border-radius:12px;padding:10px 12px;margin-bottom:12px;font-size:14px}");
	Строки.Добавить(".hint{font-size:12px;color:#6B7280;margin:4px 0 10px;line-height:1.4}");
	Строки.Добавить("</style></head><body>");
	Строки.Добавить("<h1>Резервное копирование</h1>");
	Строки.Добавить(СтатусБлок);
	Строки.Добавить("<div class=""card"">");
	Строки.Добавить("<div class=""row""><span class=""lbl"">Google-аккаунт</span><span class=""val"">" + Аккаунт + "</span></div>");
	Строки.Добавить("<div class=""row""><span class=""lbl"">Папка копий</span><span class=""val"">" + КаталогКопий + "</span></div>");
	Строки.Добавить("<div class=""row""><span class=""lbl"">Локальная копия</span><span class=""val"">" + Локальная + "</span></div>");
	Строки.Добавить("<div class=""row""><span class=""lbl"">Облачная копия</span><span class=""val"">" + Облачная + "</span></div>");
	Строки.Добавить("</div>");
	
	Если ЗначениеЗаполнено(Сведения.Email) Или Сведения.ЕстьТокен Тогда
		
		Строки.Добавить("<a class=""btn danger"" href=""app:disconnect-google"">Отключить Google-аккаунт</a>");
		
	Иначе
		
		Строки.Добавить("<a class=""btn-google"" href=""app:connect-google"">");
		Строки.Добавить("<span class=""g-icon"">" + SVGИконкаGoogle() + "</span>");
		Строки.Добавить("<span class=""g-text"">Войти через Google</span>");
		Строки.Добавить("</a>");
		Строки.Добавить("<div class=""hint"">На мобильном приложении откроется системный выбор аккаунта Google на телефоне.</div>");
		
	КонецЕсли;
	
	Если Не Сведения.ClientIdЗадан Тогда
		
		Строки.Добавить("<a class=""btn muted"" href=""app:set-client-id"">Указать Google OAuth Client ID</a>");
		
	КонецЕсли;
	
	Если Не Сведения.ClientSecretЗадан Тогда
		
		Строки.Добавить("<a class=""btn muted"" href=""app:set-client-secret"">Указать Google OAuth Client Secret</a>");
		Строки.Добавить("<div class=""hint"">Для входа через браузер нужен Client Secret из Google Cloud (Device/TV клиент).</div>");
		
	КонецЕсли;
	
	Строки.Добавить("<a class=""btn muted"" href=""app:choose-backup-folder"">Выбрать папку для локальных копий</a>");
	Строки.Добавить("<a class=""btn secondary"" href=""app:backup-local"">Создать локальную резервную копию</a>");
	Строки.Добавить("<div class=""hint"">В первый раз выберите папку. Дальше копии будут сохраняться туда автоматически.</div>");
	Строки.Добавить("<a class=""btn secondary"" href=""app:backup-cloud"">Создать резервную копию в Google</a>");
	Строки.Добавить("<a class=""btn muted"" href=""app:restore-local"">Восстановить из локального файла</a>");
	Строки.Добавить("<a class=""btn muted"" href=""app:restore-cloud"">Восстановить из Google Drive</a>");
	Строки.Добавить("<a class=""btn muted"" href=""app:close"">Закрыть</a>");
	Строки.Добавить("</body></html>");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаСервере
Функция СобратьHTMLОжиданияАвторизации()
	
	Строки = Новый Массив;
	Строки.Добавить("<!DOCTYPE html><html lang=""ru""><head><meta charset=""utf-8"">");
	Строки.Добавить("<meta name=""viewport"" content=""width=device-width, initial-scale=1"">");
	Строки.Добавить("<style>body{font-family:-apple-system,sans-serif;padding:16px;background:#F8FAFC}");
	Строки.Добавить("h1{font-size:20px}.btn{display:block;text-align:center;padding:12px;border-radius:12px;text-decoration:none;margin:8px 0;font-weight:600}");
	Строки.Добавить(".btn.primary{background:#2563EB;color:#fff}.btn.muted{background:#F3F4F6;color:#374151}");
	Строки.Добавить(".box{background:#fff;border:1px solid #E5E7EB;border-radius:16px;padding:14px;margin:12px 0}");
	Строки.Добавить(".code{font-size:28px;font-weight:700;letter-spacing:2px;text-align:center;margin:10px 0}");
	Строки.Добавить(".status{color:#065F46;margin:10px 0}</style></head><body>");
	Строки.Добавить("<h1>Подключение Google</h1>");
	Строки.Добавить("<div class=""box"">");
	Строки.Добавить("<div>1. В браузере откроется страница Google — код уже подставлен</div>");
	Строки.Добавить("<div>2. Выберите аккаунт и разрешите доступ</div>");
	Строки.Добавить("<div>3. Вернитесь сюда и нажмите «Проверить»</div>");
	Строки.Добавить("<div class=""code"">" + ЭкранироватьHTML(СтатусСообщения) + "</div>");
	Строки.Добавить("<div style=""font-size:12px;color:#6B7280;text-align:center"">Если код не подставился — введите его вручную</div>");
	Строки.Добавить("</div>");
	Строки.Добавить("<a class=""btn primary"" href=""app:poll-auth"">Проверить авторизацию</a>");
	Строки.Добавить("<a class=""btn muted"" href=""app:back-main"">Отмена</a>");
	Строки.Добавить("</body></html>");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаСервере
Функция СобратьHTMLСпискаDrive()
	
	Строки = Новый Массив;
	Строки.Добавить("<!DOCTYPE html><html lang=""ru""><head><meta charset=""utf-8"">");
	Строки.Добавить("<meta name=""viewport"" content=""width=device-width, initial-scale=1"">");
	Строки.Добавить("<style>body{font-family:-apple-system,sans-serif;padding:16px;background:#F8FAFC}");
	Строки.Добавить("h1{font-size:20px}.item{display:block;background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:12px;margin:8px 0;text-decoration:none;color:#111827}");
	Строки.Добавить(".name{font-weight:600}.meta{font-size:12px;color:#6B7280;margin-top:4px}");
	Строки.Добавить(".btn{display:block;text-align:center;padding:12px;border-radius:12px;text-decoration:none;margin:8px 0;font-weight:600;background:#F3F4F6;color:#374151}");
	Строки.Добавить(".status{margin-bottom:10px;color:#065F46}</style></head><body>");
	Строки.Добавить("<h1>Копии на Google Drive</h1>");
	
	Если ЗначениеЗаполнено(СтатусСообщения) Тогда
		
		Строки.Добавить("<div class=""status"">" + ЭкранироватьHTML(СтатусСообщения) + "</div>");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СписокФайловDriveJSON) Тогда
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СписокФайловDriveJSON);
		Файлы = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(Файлы) = Тип("Массив") Тогда
			
			Для Каждого Файл Из Файлы Цикл
				
				Строки.Добавить("<a class=""item"" href=""app:restore-drive:" + ЭкранироватьHTML(Файл.Id) + """>");
				Строки.Добавить("<div class=""name"">" + ЭкранироватьHTML(Файл.Имя) + "</div>");
				Строки.Добавить("<div class=""meta"">" + ЭкранироватьHTML(Строка(Файл.Дата)) + "</div>");
				Строки.Добавить("</a>");
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Строки.Добавить("<a class=""btn"" href=""app:back-main"">Назад</a>");
	Строки.Добавить("</body></html>");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаСервере
Функция ФорматДатыКопии(ДатаКопии)
	
	Если Не ЗначениеЗаполнено(ДатаКопии) Тогда
		
		Возврат "ещё не создавалась";
		
	КонецЕсли;
	
	Возврат Формат(ДатаКопии, "ДФ='dd.MM.yyyy HH:mm'");
	
КонецФункции

&НаСервере
Функция ЭкранироватьHTML(Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
