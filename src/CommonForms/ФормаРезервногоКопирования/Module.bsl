		+ "<path fill=""#4CAF50"" d=""M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.3 35.3 26.8 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z""/>"
		+ "<path fill=""#1976D2"" d=""M43.6 20.5H42V20H24v8h11.3c-1.1 3.1-3.5 5.5-6.1 7.1l.1.1 6.2 5.2C37.4 38.8 44 34 44 24c0-1.3-.1-2.7-.4-3.5z""/>"
		+ "</svg>";
	
КонецФункции

&НаКлиенте
Функция ИзвлечьКомандуИзСсылки(Знач Href)
	
	Если Не ЗначениеЗаполнено(Href) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Маркер = "app:";
	Позиция = СтрНайти(Href, Маркер);
	
	Если Позиция = 0 Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат Сред(Href, Позиция + СтрДлина(Маркер));
	
КонецФункции

&НаКлиенте
Процедура СоздатьЛокальнуюКопию()
	
	Каталог = КаталогЛокальныхКопийНаСервере();
	
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		
		ВыбратьКаталогЛокальныхКопий(Истина);
		Возврат;
		
	КонецЕсли;
	
	СоздатьЛокальнуюКопиюВКаталоге(Каталог);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогЛокальныхКопий(СоздатьКопиюПослеВыбора)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите папку для локальных резервных копий";
	Диалог.МножественныйВыбор = Ложь;
	
	ТекущийКаталог = КаталогЛокальныхКопийНаСервере();
	
	Если ЗначениеЗаполнено(ТекущийКаталог) Тогда
		
		Диалог.Каталог = ТекущийКаталог;
		
	КонецЕсли;
	
	Если Не Диалог.Выбрать() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Каталог = СокрЛП(Диалог.Каталог);
	
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		
		ПоказатьПредупреждение(, "Папка не выбрана.");
		Возврат;
		
	КонецЕсли;
	
	СохранитьКаталогЛокальныхКопийНаСервере(Каталог);
	СтатусСообщения = "Папка для копий: " + Каталог;
	ОбновитьHTMLНаСервере();
	
	Если СоздатьКопиюПослеВыбора Тогда
		
		СоздатьЛокальнуюКопиюВКаталоге(Каталог);
		
	Иначе
		
		ПоказатьПредупреждение(, СтатусСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЛокальнуюКопиюВКаталоге(Каталог)
	
	Результат = СоздатьКопиюНаСервере();
	
	Если Не Результат.Успех Тогда
		
		ПоказатьПредупреждение(, Результат.Текст);
		Возврат;
		
	КонецЕсли;
	
	ПутьКФайлу = ПолныйПутьФайлаВКаталоге(Каталог, Результат.ИмяФайла);
	
	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Результат.ТекстXML);
	ЗаписьТекста.Закрыть();
	
	ЗафиксироватьЛокальнуюКопиюНаСервере();
	
	СтатусСообщения = "Локальная резервная копия сохранена:" + Символы.ПС + ПутьКФайлу;
	РежимЭкрана = "main";
	ОбновитьHTMLНаСервере();
	ПоказатьПредупреждение(, СтатусСообщения);
	
КонецПроцедуры

&НаКлиенте
Функция ПолныйПутьФайлаВКаталоге(Каталог, ИмяФайла)
	
	ПутьКаталога = СокрЛП(Каталог);
	Разделитель = ПолучитьРазделительПути();
	
	Если Прав(ПутьКаталога, 1) <> "/" И Прав(ПутьКаталога, 1) <> "\" Тогда
		
		ПутьКаталога = ПутьКаталога + Разделитель;
		
	КонецЕсли;
	
	Возврат ПутьКаталога + ИмяФайла;
	
КонецФункции

&НаКлиенте
Процедура СохранитьФайлКопииНаУстройстве(АдресВХранилище, ИмяФайла, ТекстXML, РежимСохранения)
	
	// Для Gmail / запасного сценария — каталог документов приложения.
	ПутьКФайлу = ПолныйПутьФайлаВКаталоге(КаталогДокументов(), ИмяФайла);
	
	ЗаписьТекста = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекстXML);
	ЗаписьТекста.Закрыть();
	
	Если РежимСохранения = "gmail" Тогда
		
		СтатусСообщения = "Файл сохранён:" + Символы.ПС + ПутьКФайлу
			+ Символы.ПС + "Отправьте его на Gmail или загрузите в Drive.";
		
	Иначе
		
		СтатусСообщения = "Файл сохранён:" + Символы.ПС + ПутьКФайлу;
		
	КонецЕсли;
	
	РежимЭкрана = "main";
	ОбновитьHTMLНаСервере();
	ПоказатьПредупреждение(, СтатусСообщения);
	
КонецПроцедуры

