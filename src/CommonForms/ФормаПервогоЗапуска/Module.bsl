////////////////////////////////////////////////////////////////////////////////
// Форма первого запуска Wallet: приветствие → валюта → стартовый счёт.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Шаг = "welcome";
	ТипСчета = "cash";
	ИмяСчета = "Наличные";
	НачальныйОстаток = 0;
	ВыбраннаяВалюта = ОбщийМодульСервер_СистемныеНастройки.ВалютаПоУмолчаниюПоРегиону();
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	КомандаПриложения = ИзвлечьКомандуИзСсылки(ДанныеСобытия.Href);
	
	Если Не ЗначениеЗаполнено(КомандаПриложения) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОшибкаШага = "";
	
	Если КомандаПриложения = "start" Тогда
		
		Шаг = "currency";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли КомандаПриложения = "skip" Тогда
		
		ПропуститьНастройку();
		
	ИначеЕсли СтрНачинаетсяС(КомандаПриложения, "currency:") Тогда
		
		ВыбратьВалютуПоКоду(Сред(КомандаПриложения, СтрДлина("currency:") + 1));
		
	ИначеЕсли КомандаПриложения = "next-account" Тогда
		
		Если Не ЗначениеЗаполнено(ВыбраннаяВалюта) Тогда
			
			ОшибкаШага = "Выберите основную валюту.";
			ОбновитьHTMLНаСервере();
			Возврат;
			
		КонецЕсли;
		
		Шаг = "account";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли СтрНачинаетсяС(КомандаПриложения, "account-type:") Тогда
		
		ТипСчета = Сред(КомандаПриложения, СтрДлина("account-type:") + 1);
		ИмяСчета = ИмяСчетаПоТипу(ТипСчета);
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли КомандаПриложения = "edit-name" Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаИмениСчета", ЭтотОбъект);
		ПоказатьВводСтроки(Оповещение, ИмяСчета, "Название счёта", 25);
		
	ИначеЕсли КомандаПриложения = "edit-balance" Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаОстатка", ЭтотОбъект);
		ПоказатьВводЧисла(Оповещение, НачальныйОстаток, "Начальный остаток", 15, 2);
		
	ИначеЕсли КомандаПриложения = "finish" Тогда
		
		ЗавершитьНастройку();
		
	ИначеЕсли КомандаПриложения = "back-welcome" Тогда
		
		Шаг = "welcome";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли КомандаПриложения = "back-currency" Тогда
		
		Шаг = "currency";
		ОбновитьHTMLНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьHTMLНаСервере()
	
	Если Шаг = "currency" Тогда
		
		ТекстHTML = СобратьHTMLВалюты();
		
	ИначеЕсли Шаг = "account" Тогда
		
		ТекстHTML = СобратьHTMLСчета();
		
	Иначе
		
		ТекстHTML = СобратьHTMLПриветствия();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СобратьHTMLПриветствия()
	
	Строки = Новый Массив;
	ДобавитьОбщиеСтили(Строки);
	Строки.Добавить("<div class=""brand"">Wallet</div>");
	Строки.Добавить("<h1>Добро пожаловать</h1>");
	Строки.Добавить("<p class=""lead"">Учёт доходов, расходов, счетов, переводов и долгов — просто и быстро.</p>");
	Строки.Добавить("<ul class=""features"">");
	Строки.Добавить("<li>Баланс по счетам на главном экране</li>");
	Строки.Добавить("<li>Категории доходов и расходов уже готовы</li>");
	Строки.Добавить("<li>Настройка займёт около минуты</li>");
	Строки.Добавить("</ul>");
	Строки.Добавить("<a class=""btn primary"" href=""app:start"">Начать настройку</a>");
	Строки.Добавить("<a class=""btn muted"" href=""app:skip"">Пропустить и открыть приложение</a>");
	Строки.Добавить("</body></html>");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаСервере
Функция СобратьHTMLВалюты()
	
	Строки = Новый Массив;
	ДобавитьОбщиеСтили(Строки);
	Строки.Добавить("<a class=""back"" href=""app:back-welcome"">← Назад</a>");
	Строки.Добавить("<div class=""step"">Шаг 1 из 2</div>");
	Строки.Добавить("<h1>Основная валюта</h1>");
	Строки.Добавить("<p class=""lead"">В этой валюте будут баланс и отчёты.</p>");
	
	Если ЗначениеЗаполнено(ОшибкаШага) Тогда
		
		Строки.Добавить("<div class=""error"">" + ЭкранироватьHTML(ОшибкаШага) + "</div>");
		
	КонецЕсли;
	
	Строки.Добавить("<div class=""list"">");
	
	Для Каждого СтрокаВалюты Из СписокВалютДляВыбора() Цикл
		
		Класс = ?(СтрокаВалюты.Ссылка = ВыбраннаяВалюта, "item selected", "item");
		Строки.Добавить("<a class=""" + Класс + """ href=""app:currency:" + ЭкранироватьHTML(СтрокаВалюты.Код) + """>");
		Строки.Добавить("<span class=""name"">" + ЭкранироватьHTML(СтрокаВалюты.Наименование) + "</span>");
		Строки.Добавить("<span class=""code"">" + ЭкранироватьHTML(СтрокаВалюты.Код) + "</span>");
		Строки.Добавить("</a>");
		
	КонецЦикла;
	
	Строки.Добавить("</div>");
	Строки.Добавить("<a class=""btn primary"" href=""app:next-account"">Продолжить</a>");
	Строки.Добавить("</body></html>");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаСервере
Функция СобратьHTMLСчета()
	
	Строки = Новый Массив;
	ДобавитьОбщиеСтили(Строки);
	Строки.Добавить("<a class=""back"" href=""app:back-currency"">← Назад</a>");
	Строки.Добавить("<div class=""step"">Шаг 2 из 2</div>");
	Строки.Добавить("<h1>Стартовый счёт</h1>");
	Строки.Добавить("<p class=""lead"">Выберите тип и при необходимости укажите остаток.</p>");
	
	Если ЗначениеЗаполнено(ОшибкаШага) Тогда
		
		Строки.Добавить("<div class=""error"">" + ЭкранироватьHTML(ОшибкаШага) + "</div>");
		
	КонецЕсли;
	
	Строки.Добавить("<div class=""chips"">");
	Строки.Добавить(ЧипТипа("cash", "Наличные"));
	Строки.Добавить(ЧипТипа("card", "Карта"));
	Строки.Добавить(ЧипТипа("bank", "Банк"));
	Строки.Добавить(ЧипТипа("kaspi", "Kaspi"));
	Строки.Добавить(ЧипТипа("other", "Другое"));
	Строки.Добавить("</div>");
	
	Строки.Добавить("<a class=""field"" href=""app:edit-name""><span class=""lbl"">Название</span><span class=""val"">"
		+ ЭкранироватьHTML(ИмяСчета) + "</span></a>");
	Строки.Добавить("<a class=""field"" href=""app:edit-balance""><span class=""lbl"">Начальный остаток</span><span class=""val"">"
		+ Формат(НачальныйОстаток, "ЧДЦ=2; ЧН=0") + "</span></a>");
	Строки.Добавить("<a class=""btn primary"" href=""app:finish"">Готово</a>");
	Строки.Добавить("</body></html>");
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаСервере
Функция ЧипТипа(КодТипа, Заголовок)
	
	Класс = ?(ТипСчета = КодТипа, "chip selected", "chip");
	
	Возврат "<a class=""" + Класс + """ href=""app:account-type:" + КодТипа + """>" + ЭкранироватьHTML(Заголовок) + "</a>";
	
КонецФункции

&НаСервере
Процедура ДобавитьОбщиеСтили(Строки)
	
	Строки.Добавить("<!DOCTYPE html><html lang=""ru""><head><meta charset=""utf-8"">");
	Строки.Добавить("<meta name=""viewport"" content=""width=device-width, initial-scale=1, maximum-scale=1"">");
	Строки.Добавить("<style>");
	Строки.Добавить("body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;margin:0;padding:20px 16px;background:#F8FAFC;color:#111827}");
	Строки.Добавить(".brand{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#2563EB;margin-bottom:10px}");
	Строки.Добавить("h1{font-size:26px;font-weight:700;margin:0 0 10px}");
	Строки.Добавить(".lead{color:#6B7280;font-size:15px;line-height:1.45;margin:0 0 16px}");
	Строки.Добавить(".features{margin:0 0 22px;padding-left:18px;color:#374151;font-size:14px;line-height:1.6}");
	Строки.Добавить(".btn{display:block;text-align:center;border-radius:14px;padding:14px;margin:10px 0;font-weight:700;text-decoration:none;font-size:16px}");
	Строки.Добавить(".btn.primary{background:#2563EB;color:#fff}");
	Строки.Добавить(".btn.muted{background:#F3F4F6;color:#374151}");
	Строки.Добавить(".back{display:inline-block;margin-bottom:10px;color:#2563EB;font-weight:600;text-decoration:none}");
	Строки.Добавить(".step{font-size:12px;color:#9CA3AF;font-weight:600;margin-bottom:6px}");
	Строки.Добавить(".list .item{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid #E5E7EB;border-radius:14px;padding:14px;margin:8px 0;text-decoration:none;color:inherit}");
	Строки.Добавить(".list .item.selected{border-color:#2563EB;background:#EFF6FF}");
	Строки.Добавить(".list .name{font-weight:700}.list .code{color:#6B7280;font-weight:600}");
	Строки.Добавить(".chips{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 16px}");
	Строки.Добавить(".chip{padding:10px 14px;border-radius:999px;background:#fff;border:1px solid #E5E7EB;text-decoration:none;color:#374151;font-weight:600;font-size:14px}");
	Строки.Добавить(".chip.selected{background:#2563EB;border-color:#2563EB;color:#fff}");
	Строки.Добавить(".field{display:flex;justify-content:space-between;gap:12px;background:#fff;border:1px solid #E5E7EB;border-radius:14px;padding:14px;margin:8px 0;text-decoration:none;color:inherit}");
	Строки.Добавить(".field .lbl{color:#6B7280;font-size:13px}.field .val{font-weight:700}");
	Строки.Добавить(".error{background:#FEF2F2;border:1px solid #FECACA;color:#B91C1C;border-radius:12px;padding:10px 12px;margin-bottom:12px;font-size:14px}");
	Строки.Добавить("</style></head><body>");
	
КонецПроцедуры

&НаСервере
Функция СписокВалютДляВыбора()
	
	Результат = Новый Массив;
	Выборка = Справочники.Валюта.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаВалюты = Новый Структура("Ссылка, Код, Наименование",
			Выборка.Ссылка, СокрЛП(Выборка.Код), Выборка.Наименование);
		Результат.Добавить(СтрокаВалюты);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЭкранироватьHTML(Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ИзвлечьКомандуИзСсылки(Знач Href)
	
	Если Не ЗначениеЗаполнено(Href) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Маркер = "app:";
	Позиция = СтрНайти(Href, Маркер);
	
	Если Позиция = 0 Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат Сред(Href, Позиция + СтрДлина(Маркер));
	
КонецФункции

&НаКлиенте
Функция ИмяСчетаПоТипу(КодТипа)
	
	Если КодТипа = "cash" Тогда
		
		Возврат "Наличные";
		
	ИначеЕсли КодТипа = "card" Тогда
		
		Возврат "Банковская карта";
		
	ИначеЕсли КодТипа = "bank" Тогда
		
		Возврат "Банковский счёт";
		
	ИначеЕсли КодТипа = "kaspi" Тогда
		
		Возврат "Kaspi";
		
	Иначе
		
		Возврат "Мой счёт";
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВыбратьВалютуПоКоду(КодВалюты)
	
	ВыбраннаяВалюта = Справочники.Валюта.НайтиПоКоду(КодВалюты);
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаИмениСчета(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ИмяСчета = СокрЛП(Значение);
	
	Если Не ЗначениеЗаполнено(ИмяСчета) Тогда
		
		ИмяСчета = ИмяСчетаПоТипу(ТипСчета);
		
	КонецЕсли;
	
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаОстатка(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НачальныйОстаток = Макс(0, Значение);
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПропуститьНастройку()
	
	Результат = ПропуститьНастройкуНаСервере();
	
	Если Не Результат.Успех Тогда
		
		ПоказатьПредупреждение(, Результат.Текст);
		Возврат;
		
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ПропуститьНастройкуНаСервере()
	
	Возврат ОбщийМодульСервер_СистемныеНастройки.ПропуститьПервыйЗапуск(ВыбраннаяВалюта);
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьНастройку()
	
	Если Не ЗначениеЗаполнено(СокрЛП(ИмяСчета)) Тогда
		
		ОшибкаШага = "Укажите название счёта.";
		ОбновитьHTMLНаСервере();
		Возврат;
		
	КонецЕсли;
	
	Результат = ЗавершитьНастройкуНаСервере();
	
	Если Не Результат.Успех Тогда
		
		ОшибкаШага = Результат.Текст;
		ОбновитьHTMLНаСервере();
		ПоказатьПредупреждение(, Результат.Текст);
		Возврат;
		
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ЗавершитьНастройкуНаСервере()
	
	Возврат ОбщийМодульСервер_СистемныеНастройки.ЗавершитьПервыйЗапуск(
		ВыбраннаяВалюта, ТипСчета, ИмяСчета, НачальныйОстаток);
	
КонецФункции

#КонецОбласти
