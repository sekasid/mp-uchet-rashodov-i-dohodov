////////////////////////////////////////////////////////////////////////////////
// Форма настроек безопасности: PIN, биометрия, скрытие сумм.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимЭкрана = "main";
	ВведённыйПИН = "";
	ПИНПодтверждение = "";
	ТекстОшибки = "";
	СтатусСообщения = "";
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	БиометрияДоступна = ОбщийМодульКлиент_Безопасность.БиометрияПоддерживается();
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Команда = ИзвлечьКоманду(ДанныеСобытия.Href);
	
	Если Не ЗначениеЗаполнено(Команда) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Команда = "close" Тогда
		
		Закрыть();
		
	ИначеЕсли Команда = "back" Тогда
		
		РежимЭкрана = "main";
		ВведённыйПИН = "";
		ПИНПодтверждение = "";
		ТекстОшибки = "";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли Команда = "enable-pin" Тогда
		
		РежимЭкрана = "set-pin";
		ВведённыйПИН = "";
		ПИНПодтверждение = "";
		ТекстОшибки = "";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли Команда = "disable-pin" Тогда
		
		РежимЭкрана = "disable-pin";
		ВведённыйПИН = "";
		ТекстОшибки = "";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли Команда = "toggle-bio" Тогда
		
		ПереключитьБиометрию();
		
	ИначеЕсли Команда = "toggle-amounts" Тогда
		
		ОбщийМодульСервер_Безопасность.ПереключитьСкрытиеСумм();
		СтатусСообщения = "Настройка скрытия сумм обновлена.";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли СтрДлина(Команда) = 1 И СтрНайти("0123456789", Команда) > 0 Тогда
		
		ДобавитьЦифру(Команда);
		
	ИначеЕсли Команда = "del" Тогда
		
		УдалитьЦифру();
		
	ИначеЕсли Команда = "ok" Тогда
		
		ПодтвердитьВводПИН();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДобавитьЦифру(Цифра)
	
	Если РежимЭкрана = "set-pin" Тогда
		
		Если СтрДлина(ВведённыйПИН) < 6 Тогда
			
			ВведённыйПИН = ВведённыйПИН + Цифра;
			
		КонецЕсли;
		
	ИначеЕсли РежимЭкрана = "confirm-pin" Тогда
		
		Если СтрДлина(ПИНПодтверждение) < 6 Тогда
			
			ПИНПодтверждение = ПИНПодтверждение + Цифра;
			
		КонецЕсли;
		
	ИначеЕсли РежимЭкрана = "disable-pin" Тогда
		
		Если СтрДлина(ВведённыйПИН) < 6 Тогда
			
			ВведённыйПИН = ВведённыйПИН + Цифра;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстОшибки = "";
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЦифру()
	
	Если РежимЭкрана = "confirm-pin" Тогда
		
		ПИНПодтверждение = Лев(ПИНПодтверждение, СтрДлина(ПИНПодтверждение) - 1);
		
	Иначе
		
		ВведённыйПИН = Лев(ВведённыйПИН, СтрДлина(ВведённыйПИН) - 1);
		
	КонецЕсли;
	
	ТекстОшибки = "";
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьВводПИН()
	
	Если РежимЭкрана = "set-pin" Тогда
		
		Если СтрДлина(ВведённыйПИН) < 4 Тогда
			
			ТекстОшибки = "Введите 4–6 цифр.";
			ОбновитьHTMLНаСервере();
			Возврат;
			
		КонецЕсли;
		
		РежимЭкрана = "confirm-pin";
		ПИНПодтверждение = "";
		ТекстОшибки = "";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли РежимЭкрана = "confirm-pin" Тогда
		
		Результат = ОбщийМодульСервер_Безопасность.УстановитьПИН(ВведённыйПИН, ПИНПодтверждение);
		
		Если Не Результат.Успех Тогда
			
			ТекстОшибки = Результат.Текст;
			РежимЭкрана = "set-pin";
			ВведённыйПИН = "";
			ПИНПодтверждение = "";
			ОбновитьHTMLНаСервере();
			Возврат;
			
		КонецЕсли;
		
		ОбщийМодульКлиент_Безопасность.УстановитьПриложениеРазблокировано(Истина);
		СтатусСообщения = Результат.Текст;
		РежимЭкрана = "main";
		ОбновитьHTMLНаСервере();
		
	ИначеЕсли РежимЭкрана = "disable-pin" Тогда
		
		Результат = ОбщийМодульСервер_Безопасность.ОтключитьПИН(ВведённыйПИН);
		
		Если Не Результат.Успех Тогда
			
			ТекстОшибки = Результат.Текст;
			ВведённыйПИН = "";
			ОбновитьHTMLНаСервере();
			Возврат;
			
		КонецЕсли;
		
		СтатусСообщения = Результат.Текст;
		РежимЭкрана = "main";
		ОбновитьHTMLНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьБиометрию()
	
	Сведения = ОбщийМодульСервер_Безопасность.СведенияДляЭкранаБезопасности();
	
	Если Не Сведения.ПинВключен Тогда
		
		ПоказатьПредупреждение(, "Сначала включите PIN-код.");
		Возврат;
		
	КонецЕсли;
	
	Если Не БиометрияДоступна Тогда
		
		ПоказатьПредупреждение(, "Биометрия не поддерживается на этом устройстве.");
		Возврат;
		
	КонецЕсли;
	
	Включить = Не Сведения.БиометрияВключена;
	
	Если Включить Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеПроверкиБиометрииДляВключения", ЭтотОбъект);
		ОбщийМодульКлиент_Безопасность.НачатьБиометрическуюПроверку(Оповещение, "Подтвердите биометрию");
		
	Иначе
		
		Результат = ОбщийМодульСервер_Безопасность.УстановитьБиометрию(Ложь);
		СтатусСообщения = Результат.Текст;
		ОбновитьHTMLНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиБиометрииДляВключения(ОтмененоПользователем, ДополнительныеПараметры) Экспорт
	
	Если ОтмененоПользователем = Истина Тогда
		
		СтатусСообщения = "Биометрия не подтверждена.";
		ОбновитьHTMLНаСервере();
		Возврат;
		
	КонецЕсли;
	
	Результат = ОбщийМодульСервер_Безопасность.УстановитьБиометрию(Истина);
	СтатусСообщения = Результат.Текст;
	ОбновитьHTMLНаСервере();
	
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьКоманду(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Текст = Строка(Ссылка);
	Маркер = "app:";
	Позиция = СтрНайти(НРег(Текст), Маркер);
	
	Если Позиция = 0 Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат Сред(Текст, Позиция + СтрДлина(Маркер));
	
КонецФункции

&НаСервере
Процедура ОбновитьHTMLНаСервере()
	
	Если РежимЭкрана = "main" Тогда
		
		ТекстHTML = HTMLГлавногоЭкрана();
		
	Иначе
		
		ТекстHTML = HTMLВводаПИН();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция HTMLГлавногоЭкрана()
	
	Сведения = ОбщийМодульСервер_Безопасность.СведенияДляЭкранаБезопасности();
	Строки = Новый Массив;
	Строки.Добавить(HTMLШапка("Безопасность"));
	
	Если ЗначениеЗаполнено(СтатусСообщения) Тогда
		
		Строки.Добавить("<div class=""ok"">" + ЭкранироватьHTML(СтатусСообщения) + "</div>");
		
	КонецЕсли;
	
	Строки.Добавить("<div class=""card"">");
	
	Если Сведения.ПинВключен Тогда
		
		Строки.Добавить(СтрокаМеню("PIN-код", "Включён", "disable-pin"));
		
	Иначе
		
		Строки.Добавить(СтрокаМеню("PIN-код", "Выключен", "enable-pin"));
		
	КонецЕсли;
	
	Если БиометрияДоступна Тогда
		
		Строки.Добавить(СтрокаМеню("Биометрия", ?(Сведения.БиометрияВключена, "Вкл", "Выкл"), "toggle-bio"));
		
	Иначе
		
		Строки.Добавить("<div class=""row""><span class=""name"">Биометрия</span><span class=""meta"">нет на устройстве</span></div>");
		
	КонецЕсли;
	
	Строки.Добавить(СтрокаМеню("Скрывать суммы", ?(Сведения.СкрыватьСуммы, "Да", "Нет"), "toggle-amounts"));
	Строки.Добавить("</div>");
	Строки.Добавить("<a class=""close"" href=""app:close"">Закрыть</a>");
	Строки.Добавить("</body></html>");
	
	Возврат СтрСоединить(Строки, "");
	
КонецФункции

&НаСервере
Функция HTMLВводаПИН()
	
	Если РежимЭкрана = "confirm-pin" Тогда
		
		ЗаголовокЭкрана = "Повторите PIN";
		ТекущийКод = ПИНПодтверждение;
		
	ИначеЕсли РежимЭкрана = "disable-pin" Тогда
		
		ЗаголовокЭкрана = "Введите текущий PIN";
		ТекущийКод = ВведённыйПИН;
		
	Иначе
		
		ЗаголовокЭкрана = "Новый PIN (4–6 цифр)";
		ТекущийКод = ВведённыйПИН;
		
	КонецЕсли;
	
	Маска = "";
	
	Для Индекс = 1 По СтрДлина(ТекущийКод) Цикл
		
		Маска = Маска + "●";
		
	КонецЦикла;
	
	Строки = Новый Массив;
	Строки.Добавить(HTMLШапка(ЗаголовокЭкрана));
	Строки.Добавить("<a class=""back"" href=""app:back"">← Назад</a>");
	Строки.Добавить("<div class=""pin"">" + Маска + "</div>");
	Строки.Добавить("<div class=""err"">" + ЭкранироватьHTML(ТекстОшибки) + "</div>");
	Строки.Добавить("<div class=""pad"">");
	
	Для Цифра = 1 По 9 Цикл
		
		Строки.Добавить("<a href=""app:" + Строка(Цифра) + """>" + Строка(Цифра) + "</a>");
		
	КонецЦикла;
	
	Строки.Добавить("<a href=""app:del"">⌫</a>");
	Строки.Добавить("<a href=""app:0"">0</a>");
	Строки.Добавить("<a href=""app:ok"">OK</a>");
	Строки.Добавить("</div></body></html>");
	
	Возврат СтрСоединить(Строки, "");
	
КонецФункции

&НаСервере
Функция HTMLШапка(Заголовок)
	
	Возврат "<!DOCTYPE html><html lang=""ru""><head><meta charset=""utf-8"">"
		+ "<meta name=""viewport"" content=""width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"">"
		+ "<style>*{box-sizing:border-box;margin:0;padding:0}"
		+ "body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif;background:#FAFAFA;color:#111827;padding:16px}"
		+ "h1{font-size:24px;font-weight:700;margin-bottom:14px}.back{display:inline-block;margin-bottom:12px;color:#2563EB;font-weight:600;text-decoration:none}"
		+ ".card{background:#fff;border:1px solid #E5E7EB;border-radius:16px;padding:4px 12px;margin-bottom:12px}"
		+ ".row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-top:1px solid #E5E7EB;text-decoration:none;color:inherit}"
		+ ".row:first-child{border-top:none}.name{font-size:15px;font-weight:600}.meta{color:#6B7280;font-weight:600}"
		+ ".ok{background:#ECFDF5;color:#166534;padding:10px 12px;border-radius:12px;margin-bottom:12px;font-size:13px}"
		+ ".err{color:#DC2626;font-size:13px;min-height:18px;margin:8px 0;text-align:center}"
		+ ".pin{font-size:28px;letter-spacing:10px;text-align:center;margin:12px 0;min-height:36px}"
		+ ".pad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:280px;margin:0 auto}"
		+ ".pad a{display:flex;align-items:center;justify-content:center;height:56px;border-radius:14px;background:#fff;border:1px solid #E5E7EB;font-size:22px;font-weight:600;color:#111;text-decoration:none}"
		+ ".close{display:block;text-align:center;margin-top:16px;color:#2563EB;font-weight:600;text-decoration:none}</style></head><body>"
		+ "<h1>" + ЭкранироватьHTML(Заголовок) + "</h1>";
	
КонецФункции

&НаСервере
Функция СтрокаМеню(Заголовок, Значение, Команда)
	
	Возврат "<a class=""row"" href=""app:" + Команда + """><span class=""name"">" + ЭкранироватьHTML(Заголовок)
		+ "</span><span class=""meta"">" + ЭкранироватьHTML(Значение) + " ›</span></a>";
	
КонецФункции

&НаСервере
Функция ЭкранироватьHTML(Знач Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
