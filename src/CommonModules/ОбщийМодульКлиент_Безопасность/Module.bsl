////////////////////////////////////////////////////////////////////////////////
// Общий модуль клиент: безопасность — разблокировка, биометрия, зеркало токенов.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Защита PIN/биометрия актуальна только в собранном мобильном приложении.
//
Функция ЭтоМобильноеПриложение() Экспорт
	
	#Если МобильноеПриложениеКлиент Тогда
		
		Возврат Истина;
		
	#Иначе
		
		Возврат Ложь;
		
	#КонецЕсли
	
КонецФункции

// Открывает форму разблокировки (блокирует интерфейс).
//
Процедура ОткрытьФормуРазблокировки() Экспорт
	
	Если Не ЭтоМобильноеПриложение() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.ФормаРазблокировки", , , , , , ,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

// Открывает настройки безопасности.
//
Процедура ОткрытьФормуБезопасности(Владелец = Неопределено) Экспорт
	
	Если Не ЭтоМобильноеПриложение() Тогда
		
		ПоказатьПредупреждение(, "Настройки безопасности доступны только в мобильном приложении.");
		Возврат;
		
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.ФормаБезопасности", , Владелец, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

// Признак успешной разблокировки в текущем сеансе клиента.
//
Функция ПриложениеРазблокировано() Экспорт
	
	Если Не ЭтоМобильноеПриложение() Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат WalletПриложениеРазблокировано();
	
КонецФункции

Процедура УстановитьПриложениеРазблокировано(Значение) Экспорт
	
	Если Не ЭтоМобильноеПриложение() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	WalletУстановитьРазблокировку(Значение);
	
КонецПроцедуры

// Сбрасывает разблокировку (после сворачивания / пробуждения).
//
Процедура ЗаблокироватьПриложение() Экспорт
	
	Если Не ЭтоМобильноеПриложение() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ОбщийМодульСервер_Безопасность.ПинВключен() Тогда
		
		УстановитьПриложениеРазблокировано(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

// Если PIN включён и сеанс не разблокирован — открывает форму разблокировки.
// Возвращает Истина, если блокировка запрошена.
//
Функция ОбеспечитьРазблокировкуЕслиНужно() Экспорт
	
	Если Не ЭтоМобильноеПриложение() Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Не ОбщийМодульСервер_Безопасность.ПинВключен() Тогда
		
		УстановитьПриложениеРазблокировано(Истина);
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ПриложениеРазблокировано() Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ОткрытьФормуРазблокировки();
	
	Возврат Истина;
	
КонецФункции

// Проверяет поддержку биометрии устройством.
//
Функция БиометрияПоддерживается() Экспорт
	
	#Если МобильноеПриложениеКлиент Тогда
		
		Попытка
			
			Способ = СпособДополнительнойПроверкиПользователя.ТолькоБиометрическая;
			
			Возврат ДополнительнаяПроверкаПользователя.ПоддерживаетсяПроверка(Способ);
			
		Исключение
			
			Возврат Ложь;
			
		КонецПопытки;
		
	#Иначе
		
		Возврат Ложь;
		
	#КонецЕсли
	
КонецФункции

// Запускает биометрическую проверку. Оповещение(ОтмененоПользователем, ДопПараметры).
//
Процедура НачатьБиометрическуюПроверку(ОписаниеОповещения, ТекстПодсказки = "Подтвердите вход") Экспорт
	
	#Если МобильноеПриложениеКлиент Тогда
		
		Попытка
			
			Способ = СпособДополнительнойПроверкиПользователя.ТолькоБиометрическая;
			
			Если Не ДополнительнаяПроверкаПользователя.ПоддерживаетсяПроверка(Способ) Тогда
				
				ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
				Возврат;
				
			КонецЕсли;
			
			ДополнительнаяПроверкаПользователя.НачатьПроверку(Способ, ТекстПодсказки, ОписаниеОповещения);
			
		Исключение
			
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
			
		КонецПопытки;
		
	#Иначе
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
		
	#КонецЕсли
	
КонецПроцедуры

// Дублирует токены Google в БезопасноеХранилище ОС (если доступно).
//
Процедура ЗеркалироватьТокеныGoogleВБезопасноеХранилище(AccessToken, RefreshToken) Экспорт
	
	#Если МобильноеПриложениеКлиент Тогда
		
		Попытка
			
			Если Не БезопасноеХранилище.ПоддерживаетсяЗащитаДоступа(СпособЗащитыДоступаБезопасногоХранилища.Нет) Тогда
				
				Возврат;
				
			КонецЕсли;
			
			Оповещение = Новый ОписаниеОповещения("ПослеЗеркалированияТокенаGoogle", ОбщийМодульКлиент_Безопасность);
			БезопасноеХранилище.НачатьПомещениеДанных("Wallet.Google.Access", Строка(AccessToken),
				СпособЗащитыДоступаБезопасногоХранилища.Нет, , Оповещение);
			
			Если ЗначениеЗаполнено(RefreshToken) Тогда
				
				БезопасноеХранилище.НачатьПомещениеДанных("Wallet.Google.Refresh", Строка(RefreshToken),
					СпособЗащитыДоступаБезопасногоХранилища.Нет, , Оповещение);
				
			КонецЕсли;
			
		Исключение
			
			// На эмуляторе / ПК API может отсутствовать — токены уже в ValueStorage.
			
		КонецПопытки;
		
	#КонецЕсли
	
КонецПроцедуры

Процедура ПослеЗеркалированияТокенаGoogle(Результат, Ключ, ДополнительныеПараметры) Экспорт
	
	// Результат зеркалирования не требует действий UI.
	
КонецПроцедуры

#КонецОбласти
