// Выгружает РС КурсыВалют запросом: у регистра основной отбор, пустой НаборЗаписей.Прочитать() может вернуть 0 записей.
//
Процедура ВыгрузитьКурсыВалютВXML(ЗаписьXML)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("КурсыВалют");
	ЗаписьXML.ЗаписатьНачалоЭлемента("Records");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КурсыВалют.Период КАК Период,
	|	КурсыВалют.Валюта КАК Валюта,
	|	КурсыВалют.Курс КАК Курс,
	|	КурсыВалют.Кратность КАК Кратность
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Record");
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Period");
		ЗаписьXML.ЗаписатьТекст(Формат(Выборка.Период, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Валюта");
		
		Если ЗначениеЗаполнено(Выборка.Валюта) Тогда
			
			ЗаписьXML.ЗаписатьТекст(Строка(Выборка.Валюта.УникальныйИдентификатор()));
			
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Курс");
		ЗаписьXML.ЗаписатьТекст(XMLСтрока(Выборка.Курс));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Кратность");
		ЗаписьXML.ЗаписатьТекст(XMLСтрока(Выборка.Кратность));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // Record
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Records
	ЗаписьXML.ЗаписатьКонецЭлемента(); // КурсыВалют
	
КонецПроцедуры

Процедура ОчиститьДанныеПередВосстановлением()
	
	УдалитьВсеДокументы(Документы.Доходы);
	УдалитьВсеДокументы(Документы.Расход);
	УдалитьВсеДокументы(Документы.Переводы);
	УдалитьВсеДокументы(Документы.ПередачаСредствВДолг);
	
	НаборКурсов = РегистрыСведений.КурсыВалют.СоздатьНаборЗаписей();
	НаборКурсов.Записать();
	
	УдалитьНепредопределенныеЭлементы(Справочники.Контакты);
	УдалитьНепредопределенныеЭлементы(Справочники.Счета);
	УдалитьНепредопределенныеЭлементы(Справочники.КатегорииДоходов);
	УдалитьНепредопределенныеЭлементы(Справочники.КатегорииРасходов);
	УдалитьНепредопределенныеЭлементы(Справочники.Валюта);
	
КонецПроцедуры

Процедура УдалитьВсеДокументы(МенеджерДокумента)
	
	Выборка = МенеджерДокумента.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбъектДокумента = Выборка.ПолучитьОбъект();
		
		Если ОбъектДокумента.Проведен Тогда
			
			ОбъектДокумента.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			
		КонецЕсли;
		
		ОбъектДокумента.Удалить();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНепредопределенныеЭлементы(МенеджерСправочника)
	
	Если МенеджерСправочника = Справочники.КатегорииДоходов Тогда
		
		УдалитьНепредопределенныеИерархия("Справочник.КатегорииДоходов");
		
	ИначеЕсли МенеджерСправочника = Справочники.КатегорииРасходов Тогда
		
		УдалитьНепредопределенныеИерархия("Справочник.КатегорииРасходов");
		
	Иначе
		
		Выборка = МенеджерСправочника.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Предопределенный Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ОбъектСправочника = Выборка.ПолучитьОбъект();
			ОбъектСправочника.Удалить();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьНепредопределенныеИерархия(ИмяТаблицы)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	" + ИмяТаблицы + " КАК Таблица
	|ГДЕ
	|	НЕ Таблица.Предопределенный
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таблица.ЭтоГруппа";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбъектСправочника = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектСправочника.Удалить();
		
	КонецЦикла;
	
