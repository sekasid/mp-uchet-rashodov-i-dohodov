		ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеИзТекстаXML(ТекстXML)
	
	Контекст = НовыйКонтекстВосстановления();
	ТекстXML = ПодготовитьXMLКВосстановлению(ТекстXML);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстXML);
	
	КореньНайден = Ложь;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "WalletBackup" Тогда
			
			КореньНайден = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не КореньНайден Тогда
		
		ВызватьИсключение "В файле не найден корень WalletBackup.";
		
	КонецЕсли;
	
	// Входим внутрь корня и читаем секции Constants / Catalogs / Documents.
	ЧтениеXML.Прочитать();
	
	Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ЧтениеXML.Имя = "Constants" Тогда
				
				ПрочитатьКонстантыИзXML(ЧтениеXML, Контекст);
				
			ИначеЕсли ЧтениеXML.Имя = "Catalogs" Тогда
				
				ПрочитатьКонтейнерОбъектов(ЧтениеXML, Контекст);
				
			ИначеЕсли ЧтениеXML.Имя = "Documents" Тогда
				
				ПрочитатьКонтейнерОбъектов(ЧтениеXML, Контекст);
				
			ИначеЕсли ЧтениеXML.Имя = "InformationRegisters" Или ЧтениеXML.Имя = "AccumulationRegisters" Тогда
				
				ПрочитатьКонтейнерОбъектов(ЧтениеXML, Контекст);
				
			Иначе
				
				ЧтениеXML.Пропустить();
				
			КонецЕсли;
			
		Иначе
			
			Если Не ЧтениеXML.Прочитать() Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Закрыть();
	ПрименитьОтложенныхРодителейКатегорий(Контекст);
	
	Если ЗначениеЗаполнено(Контекст.ОтложеннаяВалютаУчетаУид) Тогда
		
		Константы.ВалютаУчета.Установить(СсылкаСправочникаПоУИД(Контекст, Справочники.Валюта, Контекст.ОтложеннаяВалютаУчетаУид));
		
	КонецЕсли;
	
КонецПроцедуры

// Контекст загрузки копии: соответствие ссылок и отложенные операции.
//
Функция НовыйКонтекстВосстановления()
	
	Контекст = Новый Структура;
	Контекст.Вставить("Ссылки", Новый Соответствие);
	Контекст.Вставить("ОтложенныеРодители", Новый Массив);
	Контекст.Вставить("ОтложеннаяВалютаУчетаУид", "");
	
	Возврат Контекст;
	
КонецФункции

// Добавляет пространство имён конфигурации в старые копии (без xmlns объекты не читаются).
//
Функция ПодготовитьXMLКВосстановлению(ТекстXML)
	
	URIКонфигурации = "http://v8.1c.ru/8.1/data/enterprise/current-config";
	
	Если СтрНайти(ТекстXML, URIКонфигурации) = 0 Тогда
		
		ТекстXML = СтрЗаменить(ТекстXML, "<WalletBackup ",
			"<WalletBackup xmlns=""" + URIКонфигурации
			+ """ xmlns:xs=""http://www.w3.org/2001/XMLSchema"""
			+ " xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" ");
		
	КонецЕсли;
	
	// xmlns="" на вложенных элементах сбрасывает пространство имён — мешает чтению регистров.
	ТекстXML = СтрЗаменить(ТекстXML, " xmlns=""""", "");
	
	Возврат ТекстXML;
	
КонецФункции

// Возвращает число документов учёта в информационной базе.
//
Функция КоличествоДокументовУчета()
	
	Возврат КоличествоЭлементовМенеджера(Документы.Доходы)
		+ КоличествоЭлементовМенеджера(Документы.Расход)
		+ КоличествоЭлементовМенеджера(Документы.Переводы)
		+ КоличествоЭлементовМенеджера(Документы.ПередачаСредствВДолг);
	
КонецФункции

// Подсчитывает элементы выборки менеджера документов или справочников.
//
Функция КоличествоЭлементовМенеджера(МенеджерОбъекта)
	
	Количество = 0;
	Выборка = МенеджерОбъекта.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Количество = Количество + 1;
		
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

Процедура ПрочитатьКонстантыИзXML(ЧтениеXML, Контекст)
	
	ЧтениеXML.Прочитать();
	
	Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Constant" Тогда
			
			ИмяКонстанты = ЧтениеXML.ПолучитьАтрибут("Name");
			ЗначениеКонстанты = Неопределено;
			ЧтениеXML.Прочитать();
			
			Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Value" Тогда
					
					Если ВозможностьЧтенияXML(ЧтениеXML) Тогда
						
						ЗначениеКонстанты = ПрочитатьXML(ЧтениеXML);
						
					Иначе
						
						ЗначениеКонстанты = ПрочитатьТекстовоеЗначениеУзла(ЧтениеXML);
						
					КонецЕсли;
					
				ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
					
					ЧтениеXML.Пропустить();
					
				Иначе
					
					Если Не ЧтениеXML.Прочитать() Тогда
						
						Прервать;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			УстановитьКонстантуПоИмени(ИмяКонстанты, ЗначениеКонстанты, Контекст);
			ЧтениеXML.Прочитать(); // конец Constant
			
		Иначе
			
			Если Не ЧтениеXML.Прочитать() Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Прочитать(); // конец Constants
	
КонецПроцедуры

Функция ПрочитатьТекстовоеЗначениеУзла(ЧтениеXML)
	
	ТекстЗначения = "";
	ЧтениеXML.Прочитать();
	
	Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Или ЧтениеXML.ТипУзла = ТипУзлаXML.ЗначениеCDATA Тогда
			
			ТекстЗначения = ТекстЗначения + ЧтениеXML.Значение;
			
		КонецЕсли;
		
		Если Не ЧтениеXML.Прочитать() Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Прочитать(); // конец Value
	Возврат ТекстЗначения;
	
КонецФункции

Процедура УстановитьКонстантуПоИмени(ИмяКонстанты, ЗначениеКонстанты, Контекст)
	
	Если ИмяКонстанты = "ВалютаУчета" Тогда
		
		Контекст.ОтложеннаяВалютаУчетаУид = СокрЛП(Строка(ЗначениеКонстанты));
		
	ИначеЕсли ИмяКонстанты = "ПервыйЗапуск" Тогда
		
		Константы.ПервыйЗапуск.Установить(ПривестиБулево(ЗначениеКонстанты));
		
	ИначеЕсли ИмяКонстанты = "АвтообновлениеКурсовВалют" Тогда
		
		Константы.АвтообновлениеКурсовВалют.Установить(ПривестиБулево(ЗначениеКонстанты));
		
	ИначеЕсли ИмяКонстанты = "GoogleАккаунтEmail" Тогда
		
		Константы.GoogleАккаунтEmail.Установить(Строка(ЗначениеКонстанты));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПривестиСсылкуВалюты(ЗначениеКонстанты)
	
	Если ТипЗнч(ЗначениеКонстанты) = Тип("СправочникСсылка.Валюта") Тогда
		
		Возврат ЗначениеКонстанты;
		
	КонецЕсли;
	
	ТекстСсылки = СокрЛП(Строка(ЗначениеКонстанты));
	
	Если Не ЗначениеЗаполнено(ТекстСсылки) Тогда
		
		Возврат Справочники.Валюта.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат Справочники.Валюта.ПолучитьСсылку(Новый УникальныйИдентификатор(ТекстСсылки));
	
КонецФункции

Функция ПривестиБулево(ЗначениеКонстанты)
	
	Если ТипЗнч(ЗначениеКонстанты) = Тип("Булево") Тогда
		
		Возврат ЗначениеКонстанты;
		
	КонецЕсли;
	
	Текст = НРег(СокрЛП(Строка(ЗначениеКонстанты)));
	Возврат Текст = "true" Или Текст = "истина" Или Текст = "1" Или Текст = "yes";
	
КонецФункции

Процедура ПрочитатьКонтейнерОбъектов(ЧтениеXML, Контекст)
	
	ЧтениеXML.Прочитать();
	
	Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ЧтениеXML.Имя = "КурсыВалют" Тогда
				
				ПрочитатьКурсыВалютИзXML(ЧтениеXML, Контекст);
				
			ИначеЕсли ЭтоСериализуемыйОбъектКонфигурации(ЧтениеXML.Имя) Тогда
				
				ЗагрузитьОбъектКонфигурацииИзXML(ЧтениеXML, Контекст);
				
			Иначе
				
				ПрочитатьВложенныеОбъекты(ЧтениеXML, Контекст);
				
			КонецЕсли;
			
		Иначе
			
			Если Не ЧтениеXML.Прочитать() Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Прочитать();
	
КонецПроцедуры

Процедура ПрочитатьВложенныеОбъекты(ЧтениеXML, Контекст)
	
	ЧтениеXML.Прочитать();
	
	Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ЭтоСериализуемыйОбъектКонфигурации(ЧтениеXML.Имя) Тогда
				
				ЗагрузитьОбъектКонфигурацииИзXML(ЧтениеXML, Контекст);
				
			ИначеЕсли ЧтениеXML.Имя = "КурсыВалют" Тогда
				
				ПрочитатьКурсыВалютИзXML(ЧтениеXML, Контекст);
				
			Иначе
				
				ЧтениеXML.Пропустить();
				
			КонецЕсли;
			
		Иначе
			
			Если Не ЧтениеXML.Прочитать() Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Прочитать();
	
КонецПроцедуры

// Признак узла сериализации объекта конфигурации (CatalogObject.*, DocumentObject.* и т.п.).
//
Функция ЭтоСериализуемыйОбъектКонфигурации(ИмяУзла)
	
	Возврат СтрНачинаетсяС(ИмяУзла, "CatalogObject.")
		Или СтрНачинаетсяС(ИмяУзла, "DocumentObject.");
	
КонецФункции

// Загружает CatalogObject.* / DocumentObject.* вручную (формат WalletBackup без XDTO).
//
Процедура ЗагрузитьОбъектКонфигурацииИзXML(ЧтениеXML, Контекст)
	
	ИмяУзла = ЧтениеXML.Имя;
	Поля = ПрочитатьПоляЭлементаВСоответствие(ЧтениеXML);
	
	Если СтрНачинаетсяС(ИмяУзла, "CatalogObject.") Тогда
		
		ИмяСправочника = Сред(ИмяУзла, СтрДлина("CatalogObject.") + 1);
		ЗагрузитьСправочникИзПолей(ИмяСправочника, Поля, Контекст);
		
	ИначеЕсли СтрНачинаетсяС(ИмяУзла, "DocumentObject.") Тогда
		
		ИмяДокумента = Сред(ИмяУзла, СтрДлина("DocumentObject.") + 1);
		ЗагрузитьДокументИзПолей(ИмяДокумента, Поля, Контекст);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьПоляЭлементаВСоответствие(ЧтениеXML)
	
	Поля = Новый Соответствие;
	
	ЧтениеXML.Прочитать();
	
	Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяПоля = ЧтениеXML.Имя;
			ЗначениеПоля = ПрочитатьСодержимоеПростогоЭлемента(ЧтениеXML);
			Поля.Вставить(ИмяПоля, ЗначениеПоля);
			
		Иначе
			
			Если Не ЧтениеXML.Прочитать() Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Прочитать();
	
	Возврат Поля;
	
КонецФункции

Функция ПрочитатьСодержимоеПростогоЭлемента(ЧтениеXML)
	
	Значение = "";
	ЧтениеXML.Прочитать();
	
	Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Или ЧтениеXML.ТипУзла = ТипУзлаXML.ЗначениеCDATA Тогда
			
			Значение = Значение + ЧтениеXML.Значение;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ЧтениеXML.Пропустить();
			Продолжить;
			
		КонецЕсли;
		
		Если Не ЧтениеXML.Прочитать() Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Прочитать();
	
	Возврат Значение;
	
КонецФункции

Процедура ЗагрузитьСправочникИзПолей(ИмяСправочника, Поля, Контекст)
	
	Если ИмяСправочника = "Валюта" Тогда
		
		ЗаписатьЭлементСправочника(Справочники.Валюта, Поля, ИмяСправочника, Контекст);
		
	ИначеЕсли ИмяСправочника = "КатегорииДоходов" Тогда
		
		ЗаписатьЭлементСправочника(Справочники.КатегорииДоходов, Поля, ИмяСправочника, Контекст);
		
	ИначеЕсли ИмяСправочника = "КатегорииРасходов" Тогда
		
		ЗаписатьЭлементСправочника(Справочники.КатегорииРасходов, Поля, ИмяСправочника, Контекст);
		
	ИначеЕсли ИмяСправочника = "Счета" Тогда
		
		ЗаписатьЭлементСправочника(Справочники.Счета, Поля, ИмяСправочника, Контекст);
		
	ИначеЕсли ИмяСправочника = "Контакты" Тогда
		
		ЗаписатьЭлементСправочника(Справочники.Контакты, Поля, ИмяСправочника, Контекст);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьЭлементСправочника(Менеджер, Поля, ИмяСправочника, Контекст)
	
	УидСтрока = СокрЛП(Строка(Поля.Получить("Ref")));
	ИмяПредопределенного = СокрЛП(Строка(Поля.Получить("PredefinedDataName")));
	ОбъектСправочника = Неопределено;
	
	Если ЗначениеЗаполнено(ИмяПредопределенного) Тогда
		
		СсылкаПредопределенного = НайтиПредопределенныйЭлемент(Менеджер, ИмяПредопределенного);
		
		Если СсылкаПредопределенного <> Неопределено Тогда
			
			ЗапомнитьСоответствиеСсылки(Контекст, УидСтрока, СсылкаПредопределенного);
			ОбъектСправочника = СсылкаПредопределенного.ПолучитьОбъект();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбъектСправочника = Неопределено Тогда
		
		Если Не ЗначениеЗаполнено(УидСтрока) Или ЭтоПустойУИД(УидСтрока) Тогда
			
			Возврат;
			
		КонецЕсли;
		
		Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УидСтрока));
		ОбъектСправочника = Ссылка.ПолучитьОбъект();
		
		Если ОбъектСправочника = Неопределено Тогда
			
			Если ПривестиБулево(Поля.Получить("IsFolder")) Тогда
				
				ОбъектСправочника = Менеджер.СоздатьГруппу();
				
			Иначе
				
				ОбъектСправочника = Менеджер.СоздатьЭлемент();
				
			КонецЕсли;
			
			ОбъектСправочника.УстановитьСсылкуНового(Ссылка);
			
		КонецЕсли;
		
		ЗапомнитьСоответствиеСсылки(Контекст, УидСтрока, Ссылка);
		
	КонецЕсли;
	
	Если Поля.Получить("Code") <> Неопределено Тогда
		
		ОбъектСправочника.Код = Строка(Поля.Получить("Code"));
		
	КонецЕсли;
	
	Если Поля.Получить("Description") <> Неопределено Тогда
		
		ОбъектСправочника.Наименование = Строка(Поля.Получить("Description"));
		
	КонецЕсли;
	
	Если Поля.Получить("DeletionMark") <> Неопределено Тогда
		
		ОбъектСправочника.ПометкаУдаления = ПривестиБулево(Поля.Получить("DeletionMark"));
		
	КонецЕсли;
	
	Если ИмяСправочника = "КатегорииДоходов" Или ИмяСправочника = "КатегорииРасходов" Тогда
		
		УидРодителя = Поля.Получить("Parent");
		
		Если УидРодителя <> Неопределено И Не ЭтоПустойУИД(УидРодителя) Тогда
			
			КлючРодителя = ВРег(СокрЛП(Строка(УидРодителя)));
			
			Если Контекст.Ссылки.Получить(КлючРодителя) <> Неопределено Тогда
				
				ОбъектСправочника.Родитель = СсылкаСправочникаПоУИД(Контекст, Менеджер, УидРодителя);
				
			Иначе
				
				ОбъектСправочника.Родитель = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Строка(УидРодителя))));
				Контекст.ОтложенныеРодители.Добавить(Новый Структура("Ссылка, УидРодителя, ИмяСправочника",
					?(ОбъектСправочника.ЭтоНовый(), ОбъектСправочника.ПолучитьСсылкуНового(), ОбъектСправочника.Ссылка),
					СокрЛП(Строка(УидРодителя)), ИмяСправочника));
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Поля.Получить("Описание") <> Неопределено Тогда
			
			ОбъектСправочника.Описание = Строка(Поля.Получить("Описание"));
			
		КонецЕсли;
		
		Если Поля.Получить("КодИконки") <> Неопределено Тогда
			
			ОбъектСправочника.КодИконки = Строка(Поля.Получить("КодИконки"));
			
		КонецЕсли;
		
		Если Поля.Получить("ПоказыватьВВыборе") <> Неопределено Тогда
			
			ОбъектСправочника.ПоказыватьВВыборе = ПривестиБулево(Поля.Получить("ПоказыватьВВыборе"));
			
		КонецЕсли;
		
	ИначеЕсли ИмяСправочника = "Счета" Тогда
		
		Если Поля.Получить("ВидСчета") <> Неопределено Тогда
			
			ОбъектСправочника.ВидСчета = ЗначениеПеречисленияПоИмени(Перечисления.ВидСчета, Поля.Получить("ВидСчета"));
			
		КонецЕсли;
		
	ИначеЕсли ИмяСправочника = "Контакты" Тогда
		
		Если Поля.Получить("Телефон") <> Неопределено Тогда
			
			ОбъектСправочника.Телефон = Строка(Поля.Получить("Телефон"));
			
		КонецЕсли;
		
		Если Поля.Получить("Почта") <> Неопределено Тогда
			
			ОбъектСправочника.Почта = Строка(Поля.Получить("Почта"));
			
		КонецЕсли;
		
		Если Поля.Получить("Комментарий") <> Неопределено Тогда
			
			ОбъектСправочника.Комментарий = Строка(Поля.Получить("Комментарий"));
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбъектСправочника.ОбменДанными.Загрузка = Истина;
	ОбъектСправочника.Записать();
	ЗапомнитьСоответствиеСсылки(Контекст, УидСтрока, ОбъектСправочника.Ссылка);
	
КонецПроцедуры

Процедура ЗагрузитьДокументИзПолей(ИмяДокумента, Поля, Контекст)
	
	УидСтрока = СокрЛП(Строка(Поля.Получить("Ref")));
	
	Если Не ЗначениеЗаполнено(УидСтрока) Или ЭтоПустойУИД(УидСтрока) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ИмяДокумента = "Доходы" Тогда
		
		Менеджер = Документы.Доходы;
		
	ИначеЕсли ИмяДокумента = "Расход" Тогда
		
		Менеджер = Документы.Расход;
		
	ИначеЕсли ИмяДокумента = "Переводы" Тогда
		
		Менеджер = Документы.Переводы;
		
	ИначеЕсли ИмяДокумента = "ПередачаСредствВДолг" Тогда
		
		Менеджер = Документы.ПередачаСредствВДолг;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УидСтрока));
	ОбъектДокумента = Ссылка.ПолучитьОбъект();
	
	Если ОбъектДокумента = Неопределено Тогда
		
		ОбъектДокумента = Менеджер.СоздатьДокумент();
		ОбъектДокумента.УстановитьСсылкуНового(Ссылка);
		
	КонецЕсли;
	
	Если Поля.Получить("Date") <> Неопределено И ЗначениеЗаполнено(Поля.Получить("Date")) Тогда
		
		ОбъектДокумента.Дата = XMLЗначение(Тип("Дата"), Поля.Получить("Date"));
		
	КонецЕсли;
	
	Если Поля.Получить("Number") <> Неопределено Тогда
		
		ОбъектДокумента.Номер = Строка(Поля.Получить("Number"));
		
	КонецЕсли;
	
	Если Поля.Получить("DeletionMark") <> Неопределено Тогда
		
		ОбъектДокумента.ПометкаУдаления = ПривестиБулево(Поля.Получить("DeletionMark"));
		
	КонецЕсли;
	
	Если ИмяДокумента = "Доходы" Тогда
		
		ОбъектДокумента.Валюта = СсылкаСправочникаПоУИД(Контекст, Справочники.Валюта, Поля.Получить("Валюта"));
		ОбъектДокумента.КатегорияДоходов = СсылкаСправочникаПоУИД(Контекст, Справочники.КатегорииДоходов, Поля.Получить("КатегорияДоходов"));
		ОбъектДокумента.Счет = СсылкаСправочникаПоУИД(Контекст, Справочники.Счета, Поля.Получить("Счет"));
		ОбъектДокумента.Сумма = ПривестиЧисло(Поля.Получить("Сумма"));
		ОбъектДокумента.Комментарий = Строка(Поля.Получить("Комментарий"));
		
	ИначеЕсли ИмяДокумента = "Расход" Тогда
		
		ОбъектДокумента.Валюта = СсылкаСправочникаПоУИД(Контекст, Справочники.Валюта, Поля.Получить("Валюта"));
		ОбъектДокумента.КатегорияРасхода = СсылкаСправочникаПоУИД(Контекст, Справочники.КатегорииРасходов, Поля.Получить("КатегорияРасхода"));
		ОбъектДокумента.Счет = СсылкаСправочникаПоУИД(Контекст, Справочники.Счета, Поля.Получить("Счет"));
		ОбъектДокумента.Сумма = ПривестиЧисло(Поля.Получить("Сумма"));
		ОбъектДокумента.Комментарий = Строка(Поля.Получить("Комментарий"));
		
	ИначеЕсли ИмяДокумента = "Переводы" Тогда
		
		ОбъектДокумента.Валюта = СсылкаСправочникаПоУИД(Контекст, Справочники.Валюта, Поля.Получить("Валюта"));
		ОбъектДокумента.СчетИсточник = СсылкаСправочникаПоУИД(Контекст, Справочники.Счета, Поля.Получить("СчетИсточник"));
		ОбъектДокумента.СчетПолучатель = СсылкаСправочникаПоУИД(Контекст, Справочники.Счета, Поля.Получить("СчетПолучатель"));
		ОбъектДокумента.Сумма = ПривестиЧисло(Поля.Получить("Сумма"));
		ОбъектДокумента.Комментарий = Строка(Поля.Получить("Комментарий"));
		
	ИначеЕсли ИмяДокумента = "ПередачаСредствВДолг" Тогда
		
		ОбъектДокумента.ВидОперации = ЗначениеПеречисленияПоИмени(Перечисления.ВидОперацииДолга, Поля.Получить("ВидОперации"));
		ОбъектДокумента.ТипОперации = ЗначениеПеречисленияПоИмени(Перечисления.ТипОперацииДолга, Поля.Получить("ТипОперации"));
		ОбъектДокумента.Контакт = СсылкаСправочникаПоУИД(Контекст, Справочники.Контакты, Поля.Получить("Контакт"));
		ОбъектДокумента.Счет = СсылкаСправочникаПоУИД(Контекст, Справочники.Счета, Поля.Получить("Счет"));
		ОбъектДокумента.Валюта = СсылкаСправочникаПоУИД(Контекст, Справочники.Валюта, Поля.Получить("Валюта"));
		ОбъектДокумента.Сумма = ПривестиЧисло(Поля.Получить("Сумма"));
		ОбъектДокумента.Комментарий = Строка(Поля.Получить("Комментарий"));
		
		Если ЗначениеЗаполнено(Поля.Получить("СрокВозврата")) Тогда
			
			ОбъектДокумента.СрокВозврата = XMLЗначение(Тип("Дата"), Поля.Получить("СрокВозврата"));
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбъектДокумента.ОбменДанными.Загрузка = Истина;
	ОбъектДокумента.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Процедура ПрочитатьКурсыВалютИзXML(ЧтениеXML, Контекст)
	
	НаборЗаписей = РегистрыСведений.КурсыВалют.СоздатьНаборЗаписей();
	ЧтениеXML.Прочитать();
	
	Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Records" Тогда
			
			ЧтениеXML.Прочитать();
			
			Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "Record" Тогда
					
					Поля = ПрочитатьПоляЭлементаВСоответствие(ЧтениеXML);
					Запись = НаборЗаписей.Добавить();
					
					Если ЗначениеЗаполнено(Поля.Получить("Period")) Тогда
						
						Запись.Период = XMLЗначение(Тип("Дата"), Поля.Получить("Period"));
						
					КонецЕсли;
					
					Запись.Валюта = СсылкаСправочникаПоУИД(Контекст, Справочники.Валюта, Поля.Получить("Валюта"));
					Запись.Курс = ПривестиЧисло(Поля.Получить("Курс"));
					Запись.Кратность = ПривестиЧисло(Поля.Получить("Кратность"));
					
					Если Запись.Кратность = 0 Тогда
						
						Запись.Кратность = 1;
						
					КонецЕсли;
					
				ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
					
					ЧтениеXML.Пропустить();
					
				Иначе
					
					Если Не ЧтениеXML.Прочитать() Тогда
						
						Прервать;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			ЧтениеXML.Прочитать();
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ЧтениеXML.Пропустить();
			
		Иначе
			
			Если Не ЧтениеXML.Прочитать() Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Прочитать();
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ЗапомнитьСоответствиеСсылки(Контекст, УидСтрока, Ссылка)
	
	Если Не ЗначениеЗаполнено(УидСтрока) Или ЭтоПустойУИД(УидСтрока) Или Не ЗначениеЗаполнено(Ссылка) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Контекст.Ссылки.Вставить(ВРег(СокрЛП(УидСтрока)), Ссылка);
	
КонецПроцедуры

Функция СсылкаСправочникаПоУИД(Контекст, Менеджер, УидСтрока)
	
	ТекстУид = СокрЛП(Строка(УидСтрока));
	
	Если Не ЗначениеЗаполнено(ТекстУид) Или ЭтоПустойУИД(ТекстУид) Тогда
		
		Возврат Менеджер.ПустаяСсылка();
		
	КонецЕсли;
	
	Найденная = Контекст.Ссылки.Получить(ВРег(ТекстУид));
	
	Если Найденная <> Неопределено Тогда
		
		Возврат Найденная;
		
	КонецЕсли;
	
	Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(ТекстУид));
	
КонецФункции

Функция НайтиПредопределенныйЭлемент(Менеджер, ИмяПредопределенного)
	
	Попытка
		
		Возврат Менеджер[ИмяПредопределенного];
		
	Исключение
		
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

Функция ЗначениеПеречисленияПоИмени(МенеджерПеречисления, ИмяЗначения)
	
	ТекстИмени = СокрЛП(Строка(ИмяЗначения));
	
	Если Не ЗначениеЗаполнено(ТекстИмени) Тогда
		
		Возврат МенеджерПеречисления.ПустаяСсылка();
		
	КонецЕсли;
	
	Попытка
		
		Возврат МенеджерПеречисления[ТекстИмени];
		
	Исключение
		
		Возврат МенеджерПеречисления.ПустаяСсылка();
		
	КонецПопытки;
	
КонецФункции

Функция ЭтоПустойУИД(УидСтрока)
	
	Возврат ВРег(СокрЛП(Строка(УидСтрока))) = "00000000-0000-0000-0000-000000000000";
	
КонецФункции

Функция ПривестиЧисло(ЗначениеПоля)
	
	Если ТипЗнч(ЗначениеПоля) = Тип("Число") Тогда
		
		Возврат ЗначениеПоля;
		
	КонецЕсли;
	
	Текст = СокрЛП(Строка(ЗначениеПоля));
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");
	
	Попытка
		
		Возврат Число(Текст);
		
	Исключение
		
		Возврат 0;
		
	КонецПопытки;
	
КонецФункции

Процедура ПрименитьОтложенныхРодителейКатегорий(Контекст)
	
	Если Контекст.ОтложенныеРодители = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого Элемент Из Контекст.ОтложенныеРодители Цикл
		
		ОбъектСправочника = Элемент.Ссылка.ПолучитьОбъект();
		
		Если ОбъектСправочника = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если Элемент.ИмяСправочника = "КатегорииДоходов" Тогда
			
			ОбъектСправочника.Родитель = СсылкаСправочникаПоУИД(Контекст, Справочники.КатегорииДоходов, Элемент.УидРодителя);
			
		Иначе
			
			ОбъектСправочника.Родитель = СсылкаСправочникаПоУИД(Контекст, Справочники.КатегорииРасходов, Элемент.УидРодителя);
			
		КонецЕсли;
		
		ОбъектСправочника.ОбменДанными.Загрузка = Истина;
		ОбъектСправочника.Записать();
		
	КонецЦикла;
	
	Контекст.ОтложенныеРодители.Очистить();
	
КонецПроцедуры

Процедура ЗаписатьЗагруженныеДанные(Данные)
	
	Если Данные = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("СправочникОбъект.Валюта")
		Или ТипЗнч(Данные) = Тип("СправочникОбъект.КатегорииДоходов")
		Или ТипЗнч(Данные) = Тип("СправочникОбъект.КатегорииРасходов")
		Или ТипЗнч(Данные) = Тип("СправочникОбъект.Счета")
		Или ТипЗнч(Данные) = Тип("СправочникОбъект.Контакты") Тогда
		
		Данные.ОбменДанными.Загрузка = Истина;
		Данные.Записать();
		
	ИначеЕсли ТипЗнч(Данные) = Тип("ДокументОбъект.Доходы")
		Или ТипЗнч(Данные) = Тип("ДокументОбъект.Расход")
		Или ТипЗнч(Данные) = Тип("ДокументОбъект.Переводы")
		Или ТипЗнч(Данные) = Тип("ДокументОбъект.ПередачаСредствВДолг") Тогда
		
		Данные.ОбменДанными.Загрузка = Истина;
		Данные.Записать();
		
	Иначе
		
		Данные.ОбменДанными.Загрузка = Истина;
		Данные.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьТокеныGoogle(ДанныеТокена)
	
	AccessToken = Строка(ЗначениеПоляJSON(ДанныеТокена, "access_token"));
	Refresh = "";
	RefreshЗначение = ЗначениеПоляJSON(ДанныеТокена, "refresh_token");
	
	Если ЗначениеЗаполнено(RefreshЗначение) Тогда
		
		Refresh = Строка(RefreshЗначение);
		
	КонецЕсли;
	
	ОбщийМодульСервер_Безопасность.СохранитьТокеныGoogle(AccessToken, Refresh);
	
	Срок = 3500;
	ExpiresIn = ЗначениеПоляJSON(ДанныеТокена, "expires_in");
	
	Если ЗначениеЗаполнено(ExpiresIn) Тогда
		
		Срок = Число(ExpiresIn) - 60;
		
		Если Срок < 60 Тогда
			
			Срок = 60;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Константы.GoogleТокенИстекает.Установить(ТекущаяДатаСеанса() + Срок);
	
КонецПроцедуры

Функция ОбеспечитьАктуальныйAccessToken()
	
	AccessToken = ОбщийМодульСервер_Безопасность.ПолучитьGoogleAccessToken();
	Срок = Константы.GoogleТокенИстекает.Получить();
	
	Если ЗначениеЗаполнено(AccessToken) И ЗначениеЗаполнено(Срок) И Срок > ТекущаяДатаСеанса() Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	RefreshToken = ОбщийМодульСервер_Безопасность.ПолучитьGoogleRefreshToken();
	ClientId = ClientIdПриложения();
	
	Если Не ЗначениеЗаполнено(RefreshToken) Или Не ЗначениеЗаполнено(ClientId) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Тело = "client_id=" + КодироватьСтроку(ClientId, СпособКодированияСтроки.КодировкаURL)
		+ "&refresh_token=" + КодироватьСтроку(RefreshToken, СпособКодированияСтроки.КодировкаURL)
		+ "&grant_type=refresh_token";
	
	ClientSecret = ClientSecretПриложения();
	
	Если ЗначениеЗаполнено(ClientSecret) Тогда
		
		Тело = Тело + "&client_secret=" + КодироватьСтроку(ClientSecret, СпособКодированияСтроки.КодировкаURL);
		
	КонецЕсли;
	
	ОтветHTTP = ВыполнитьHTTPЗапрос("oauth2.googleapis.com", "/token", "POST", Тело,
		"application/x-www-form-urlencoded", "");
	
	Если Не ОтветHTTP.Успех Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Данные = ПрочитатьJSONОбъект(ОтветHTTP.Тело);
	
	Если Данные = Неопределено Или Не ЗначениеЗаполнено(ЗначениеПоляJSON(Данные, "access_token")) Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	СохранитьТокеныGoogle(Данные);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьEmailПользователяGoogle()
	
	Если Не ОбеспечитьАктуальныйAccessToken() Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	ОтветHTTP = ВыполнитьHTTPЗапрос("www.googleapis.com", "/oauth2/v2/userinfo", "GET", "", "",
		ОбщийМодульСервер_Безопасность.ПолучитьGoogleAccessToken());
	
	Если Не ОтветHTTP.Успех Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Данные = ПрочитатьJSONОбъект(ОтветHTTP.Тело);
	Email = ЗначениеПоляJSON(Данные, "email");
	
	Если Не ЗначениеЗаполнено(Email) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат Строка(Email);
	
КонецФункции

Функция ЗагрузитьФайлНаGoogleDrive(ИмяФайла, ТекстXML)
	
	Результат = НовыйРезультатОперации();
	Граница = "wallet_boundary_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	CRLF = Символы.ВК + Символы.ПС;
	
	МетаданныеJSON = "{""name"":""" + ИмяФайла + """,""mimeType"":""application/xml""}";
	
	// Google требует CRLF в multipart/related.
	Тело = "--" + Граница + CRLF
		+ "Content-Type: application/json; charset=UTF-8" + CRLF + CRLF
		+ МетаданныеJSON + CRLF
		+ "--" + Граница + CRLF
		+ "Content-Type: application/xml; charset=UTF-8" + CRLF + CRLF
		+ ТекстXML + CRLF
		+ "--" + Граница + "--";
	
	ОтветHTTP = ВыполнитьHTTPЗапрос("www.googleapis.com",
		"/upload/drive/v3/files?uploadType=multipart",
		"POST", Тело, "multipart/related; boundary=" + Граница,
		ОбщийМодульСервер_Безопасность.ПолучитьGoogleAccessToken());
	
	Если Не ОтветHTTP.Успех Тогда
		
		Результат.Текст = ТекстОшибкиGoogleDrive(ОтветHTTP);
		Возврат Результат;
		
	КонецЕсли;
	
	Данные = ПрочитатьJSONОбъект(ОтветHTTP.Тело);
	ИдентификаторФайла = ЗначениеПоляJSON(Данные, "id");
	
	Если Не ЗначениеЗаполнено(ИдентификаторФайла) Тогда
		
		Результат.Текст = "Google Drive не подтвердил загрузку файла.";
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Текст = "Файл загружен в Google Drive.";
	Результат.Вставить("FileId", Строка(ИдентификаторФайла));
	
	Возврат Результат;
	
КонецФункции

// Формирует понятный текст ошибки загрузки в Drive (403 → API / scopes).
//
Функция ТекстОшибкиGoogleDrive(ОтветHTTP)
	
	Текст = ОтветHTTP.Текст;
	Код = ОтветHTTP.КодСостояния;
	Тело = "";
	
	Если ОтветHTTP.Свойство("Тело") Тогда
		
		Тело = Строка(ОтветHTTP.Тело);
		
	КонецЕсли;
	
	СообщениеGoogle = ИзвлечьСообщениеОшибкиGoogle(Тело);
	Причина = ИзвлечьПричинуОшибкиGoogle(Тело);
	
	Если ЗначениеЗаполнено(СообщениеGoogle) И СтрНайти(Текст, СообщениеGoogle) = 0 Тогда
		
		Текст = Текст + " " + СообщениеGoogle;
		
	КонецЕсли;
	
	Если Код = 403 Тогда
		
		Если СтрНайти(НРег(Причина), "accessnotconfigured") > 0
			Или СтрНайти(НРег(СообщениеGoogle), "has not been used") > 0
			Или СтрНайти(НРег(СообщениеGoogle), "is disabled") > 0
			Или СтрНайти(НРег(СообщениеGoogle), "access not configured") > 0 Тогда
			
			Текст = Текст + Символы.ПС
				+ "В Google Cloud Console включите API «Google Drive API» для проекта MobileApp и подождите 1–2 минуты.";
			
		ИначеЕсли СтрНайти(НРег(Причина), "insufficient") > 0
			Или СтрНайти(НРег(СообщениеGoogle), "insufficient") > 0
			Или СтрНайти(НРег(СообщениеGoogle), "access_token_scope") > 0 Тогда
			
			Текст = Текст + Символы.ПС
				+ "Нет права на Drive. Отключите Google-аккаунт в приложении и войдите снова — разрешите доступ к Google Drive.";
			
		Иначе
			
			Текст = Текст + Символы.ПС
				+ "Проверьте: 1) включён Google Drive API; 2) в OAuth consent screen добавлены scopes drive.file и userinfo.email;"
				+ " 3) ваш Gmail в списке тестовых пользователей; 4) переподключите аккаунт.";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СокрЛП(Текст);
	
КонецФункции

Функция ИзвлечьСообщениеОшибкиGoogle(ТелоJSON)
	
	ДанныеОшибки = ПрочитатьJSONОбъект(ТелоJSON);
	
	Если ДанныеОшибки = Неопределено Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Описание = ЗначениеПоляJSON(ДанныеОшибки, "error_description");
	
	Если ЗначениеЗаполнено(Описание) Тогда
		
		Возврат Строка(Описание);
		
	КонецЕсли;
	
	БлокОшибки = ЗначениеПоляJSON(ДанныеОшибки, "error");
	
	Если ТипЗнч(БлокОшибки) = Тип("Структура") Или ТипЗнч(БлокОшибки) = Тип("Соответствие") Тогда
		
		Сообщение = ЗначениеПоляJSON(БлокОшибки, "message");
		
		Если ЗначениеЗаполнено(Сообщение) Тогда
			
			Возврат Строка(Сообщение);
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(БлокОшибки) Тогда
		
		Возврат Строка(БлокОшибки);
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ИзвлечьПричинуОшибкиGoogle(ТелоJSON)
	
	ДанныеОшибки = ПрочитатьJSONОбъект(ТелоJSON);
	
	Если ДанныеОшибки = Неопределено Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	БлокОшибки = ЗначениеПоляJSON(ДанныеОшибки, "error");
	
	Если ТипЗнч(БлокОшибки) <> Тип("Структура") И ТипЗнч(БлокОшибки) <> Тип("Соответствие") Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Ошибки = ЗначениеПоляJSON(БлокОшибки, "errors");
	
	Если ТипЗнч(Ошибки) = Тип("Массив") И Ошибки.Количество() > 0 Тогда
		
		Первая = Ошибки[0];
		Причина = ЗначениеПоляJSON(Первая, "reason");
		
		Если ЗначениеЗаполнено(Причина) Тогда
			
			Возврат Строка(Причина);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Статус = ЗначениеПоляJSON(БлокОшибки, "status");
	
	Если ЗначениеЗаполнено(Статус) Тогда
		
		Возврат Строка(Статус);
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Читает поле из Структура или Соответствие (результат ПрочитатьJSON).
//
Функция ЗначениеПоляJSON(Данные, ИмяПоля)
	
	Если Данные = Неопределено Или Не ЗначениеЗаполнено(ИмяПоля) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		
		Значение = Неопределено;
		
		Если Данные.Свойство(ИмяПоля, Значение) Тогда
			
			Возврат Значение;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		
		Возврат Данные.Получить(ИмяПоля);
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ВыполнитьHTTPЗапрос(Сервер, Ресурс, Метод, Тело, ContentType, AccessToken)
	
	Результат = Новый Структура("Успех, Текст, Тело, КодСостояния", Ложь, "", "", 0);
	
	Попытка
		
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
		Соединение = Новый HTTPСоединение(Сервер, 443, , , , 60, ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(Ресурс);
		
		Если ЗначениеЗаполнено(ContentType) Тогда
			
			Запрос.Заголовки.Вставить("Content-Type", ContentType);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(AccessToken) Тогда
			
			Запрос.Заголовки.Вставить("Authorization", "Bearer " + AccessToken);
			
		КонецЕсли;
		
		Если Метод = "GET" Тогда
			
			Ответ = Соединение.Получить(Запрос);
			
		Иначе
			
			Если ЗначениеЗаполнено(Тело) Тогда
				
				Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8,
					ИспользованиеByteOrderMark.НеИспользовать);
				
			КонецЕсли;
			
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
			
		КонецЕсли;
		
		Результат.КодСостояния = Ответ.КодСостояния;
		Результат.Тело = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		
		Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
			
			Результат.Успех = Истина;
			
		ИначеЕсли Ответ.КодСостояния = 0 Тогда
			
			Результат.Текст = "Нет подключения к интернету. Проверьте сеть и повторите попытку.";
			
		Иначе
			
			Результат.Текст = "Ошибка сервера Google (" + Формат(Ответ.КодСостояния, "ЧГ=0") + ").";
			СообщениеGoogle = ИзвлечьСообщениеОшибкиGoogle(Результат.Тело);
			
			Если ЗначениеЗаполнено(СообщениеGoogle) Тогда
				
				Результат.Текст = Результат.Текст + " " + СообщениеGoogle;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		Результат.Текст = "Нет доступа к сети или сервису Google. Проверьте интернет и повторите.";
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьJSONОбъект(ТекстJSON)
	
	Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Возврат Данные;
		
	Исключение
		
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

#КонецОбласти
