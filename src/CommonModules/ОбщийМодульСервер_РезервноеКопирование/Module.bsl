		ОбъектСправочника = Выборка.ПолучитьОбъект();
		ЗаписатьXML(ЗаписьXML, ОбъектСправочника);
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
