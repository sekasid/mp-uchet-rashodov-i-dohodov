////////////////////////////////////////////////////////////////////////////////
// Общий модуль сервер: резервное копирование и восстановление данных Wallet.
// Формат файла: WalletBackup XML, версия 1.
// Облако: Google Drive (OAuth device code) или отправка копии на Gmail.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает сведения для экрана резервного копирования.
//
Функция СведенияОРезервномКопировании() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Email", СокрЛП(Константы.GoogleАккаунтEmail.Получить()));
	Результат.Вставить("ЕстьТокен", ОбщийМодульСервер_Безопасность.ЕстьТокеныGoogle());
	Результат.Вставить("ClientIdЗадан", ЗначениеЗаполнено(ClientIdПриложения()));
	Результат.Вставить("ClientSecretЗадан", ЗначениеЗаполнено(ClientSecretПриложения()));
	Результат.Вставить("ДатаЛокальнойКопии", Константы.ДатаПоследнейЛокальнойКопии.Получить());
	Результат.Вставить("КаталогЛокальныхКопий", СокрЛП(Константы.КаталогЛокальныхРезервныхКопий.Получить()));
	Результат.Вставить("ДатаОблачнойКопии", Константы.ДатаПоследнейОблачнойКопии.Получить());
	
	Возврат Результат;
	
КонецФункции

// Формирует файл резервной копии и помещает его во временное хранилище.
// Возвращает структуру: Успех, Текст, АдресВХранилище, ИмяФайла.
//
Функция СоздатьРезервнуюКопиюВХранилище(УникальныйИдентификаторФормы) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	ТекстXML = СформироватьТекстРезервнойКопии();
	
	Если Не ЗначениеЗаполнено(ТекстXML) Тогда
		
		Результат.Текст = "Не удалось сформировать резервную копию.";
		Возврат Результат;
		
	КонецЕсли;
	
	ИмяФайла = ИмяФайлаРезервнойКопии();
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстXML, КодировкаТекста.UTF8);
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторФормы);
	
	Результат.Успех = Истина;
	Результат.Текст = "Резервная копия создана.";
	Результат.Вставить("АдресВХранилище", Адрес);
	Результат.Вставить("ИмяФайла", ИмяФайла);
	Результат.Вставить("ТекстXML", ТекстXML);
	
	Возврат Результат;
	
КонецФункции

// Запоминает каталог на устройстве для следующих локальных копий.
//
Процедура СохранитьКаталогЛокальныхКопий(Каталог) Экспорт
	
	Константы.КаталогЛокальныхРезервныхКопий.Установить(СокрЛП(Каталог));
	
КонецПроцедуры

// Фиксирует успешное сохранение локальной копии на устройстве.
//
Процедура ЗафиксироватьУспешнуюЛокальнуюКопию() Экспорт
	
	Константы.ДатаПоследнейЛокальнойКопии.Установить(ТекущаяДатаСеанса());
	
КонецПроцедуры

// Проверяет корректность файла резервной копии.
//
Функция ПроверитьФайлРезервнойКопии(ТекстXML) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	Если Не ЗначениеЗаполнено(ТекстXML) Тогда
		
		Результат.Текст = "Файл резервной копии пуст.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если СтрНайти(ТекстXML, "<WalletBackup") = 0 Тогда
		
		Результат.Текст = "Это не файл резервной копии Wallet.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если СтрНайти(ТекстXML, "Version=""1""") = 0 И СтрНайти(ТекстXML, "Version='1'") = 0 Тогда
		
		Результат.Текст = "Неподдерживаемая версия файла резервной копии.";
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Текст = "Файл резервной копии корректный.";
	
	Возврат Результат;
	
КонецФункции

// Восстанавливает данные из текста XML резервной копии.
// Перед вызовом нужно получить подтверждение пользователя о замене данных.
//
Функция ВосстановитьИзТекстаXML(ТекстXML) Экспорт
	
	Результат = ПроверитьФайлРезервнойКопии(ТекстXML);
	
	Если Не Результат.Успех Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	ОчиститьДанныеПередВосстановлением();
	
	ОжидалосьДокументов = СтрЧислоВхождений(ТекстXML, "<DocumentObject.");
	
	Попытка
		
		ЗагрузитьДанныеИзТекстаXML(ТекстXML);
		ПровестиЗагруженныеДокументы();
		
	Исключение
		
		Результат.Успех = Ложь;
		Результат.Текст = "Ошибка при загрузке резервной копии: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + "Данные были очищены перед загрузкой. Восстановите снова из того же файла после обновления приложения.";
		Возврат Результат;
		
	КонецПопытки;
	
	ЗагруженоДокументов = КоличествоДокументовУчета();
	
	Если ОжидалосьДокументов > 0 И ЗагруженоДокументов = 0 Тогда
		
		Результат.Успех = Ложь;
		Результат.Текст = "В файле есть операции (" + Формат(ОжидалосьДокументов, "ЧГ=0")
			+ "), но после восстановления в базе их нет. Обновите приложение и повторите восстановление из того же файла.";
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Текст = "Данные успешно восстановлены из резервной копии.";
	
	Если ЗагруженоДокументов > 0 Тогда
		
		Результат.Текст = Результат.Текст + " Операций: " + Формат(ЗагруженоДокументов, "ЧГ=0") + ".";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Восстанавливает данные из двоичных данных файла во временном хранилище.
//
Функция ВосстановитьИзХранилища(АдресВХранилище) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	Если Не ЭтоАдресВременногоХранилища(АдресВХранилище) Тогда
		
		Результат.Текст = "Не удалось получить файл резервной копии.";
		Возврат Результат;
		
	КонецЕсли;
	
	Данные = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		
		ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
		
	ИначеЕсли ТипЗнч(Данные) = Тип("Строка") Тогда
		
		ТекстXML = Данные;
		
	Иначе
		
		Результат.Текст = "Неизвестный формат файла резервной копии.";
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат ВосстановитьИзТекстаXML(ТекстXML);
	
КонецФункции

// Отключает Google-аккаунт: очищает email и токены (пароль не хранится).
//
Процедура ОтключитьGoogleАккаунт() Экспорт
	
	Константы.GoogleАккаунтEmail.Установить("");
	ОбщийМодульСервер_Безопасность.ОчиститьТокеныGoogle();
	Константы.GoogleТокенИстекает.Установить('00010101');
	
КонецПроцедуры

// Сохраняет результат нативного Google Sign-In (внешняя компонента на Android).
// Пароль не передаётся и не хранится — только email и OAuth-токены.
//
Процедура СохранитьРезультатНативногоВхода(Email, AccessToken, RefreshToken = "", ExpiresIn = 3600) Экспорт
	
	Константы.GoogleАккаунтEmail.Установить(СокрЛП(Email));
	
	Если ЗначениеЗаполнено(AccessToken) Тогда
		
		ОбщийМодульСервер_Безопасность.СохранитьТокеныGoogle(AccessToken, RefreshToken);
		
		Срок = Число(ExpiresIn);
		
		Если Срок < 60 Тогда
			
			Срок = 3600;
			
		КонецЕсли;
		
		Константы.GoogleТокенИстекает.Установить(ТекущаяДатаСеанса() + Срок - 60);
		
	КонецЕсли;
	
КонецПроцедуры

// Сохраняет email Google-аккаунта без OAuth (режим отправки на Gmail).
//
Процедура СохранитьGoogleEmail(Email) Экспорт
	
	Константы.GoogleАккаунтEmail.Установить(СокрЛП(Email));
	
КонецПроцедуры

// Сохраняет OAuth Client ID приложения.
//
Процедура СохранитьGoogleOAuthClientId(ClientId) Экспорт
	
