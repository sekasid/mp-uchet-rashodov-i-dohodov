Процедура ОчиститьДанныеПередВосстановлением()
	
	УдалитьВсеДокументы(Документы.Доходы);
	УдалитьВсеДокументы(Документы.Расход);
	УдалитьВсеДокументы(Документы.Переводы);
	УдалитьВсеДокументы(Документы.ПередачаСредствВДолг);
	
	НаборКурсов = РегистрыСведений.КурсыВалют.СоздатьНаборЗаписей();
	НаборКурсов.Записать();
	
	УдалитьНепредопределенныеЭлементы(Справочники.Контакты);
	УдалитьНепредопределенныеЭлементы(Справочники.Счета);
	УдалитьНепредопределенныеЭлементы(Справочники.КатегорииДоходов);
	УдалитьНепредопределенныеЭлементы(Справочники.КатегорииРасходов);
	УдалитьНепредопределенныеЭлементы(Справочники.Валюта);
	
