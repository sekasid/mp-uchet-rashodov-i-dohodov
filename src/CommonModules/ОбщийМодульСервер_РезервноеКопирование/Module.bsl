// Страница подтверждения Google: предпочтительно с уже подставленным user_code.
//
Функция АдресСтраницыАвторизацииGoogle(ДанныеОтвета)
	
	Если ДанныеОтвета.Свойство("verification_uri_complete")
		И ЗначениеЗаполнено(ДанныеОтвета.verification_uri_complete) Тогда
		
		Возврат Строка(ДанныеОтвета.verification_uri_complete);
		
	КонецЕсли;
	
	Если ДанныеОтвета.Свойство("verification_url_complete")
		И ЗначениеЗаполнено(ДанныеОтвета.verification_url_complete) Тогда
		
		Возврат Строка(ДанныеОтвета.verification_url_complete);
		
	КонецЕсли;
	
	БазовыйАдрес = "https://www.google.com/device";
	
	Если ДанныеОтвета.Свойство("verification_uri") И ЗначениеЗаполнено(ДанныеОтвета.verification_uri) Тогда
		
		БазовыйАдрес = Строка(ДанныеОтвета.verification_uri);
		
	ИначеЕсли ДанныеОтвета.Свойство("verification_url") И ЗначениеЗаполнено(ДанныеОтвета.verification_url) Тогда
		
		БазовыйАдрес = Строка(ДанныеОтвета.verification_url);
		
	КонецЕсли;
	
	КодПользователя = "";
	
	Если ДанныеОтвета.Свойство("user_code") Тогда
		
		КодПользователя = Строка(ДанныеОтвета.user_code);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КодПользователя) Тогда
		
		Возврат БазовыйАдрес;
		
	КонецЕсли;
	
	Разделитель = ?(СтрНайти(БазовыйАдрес, "?") > 0, "&", "?");
	
	Возврат БазовыйАдрес + Разделитель + "user_code="
		+ КодироватьСтроку(КодПользователя, СпособКодированияСтроки.КодировкаURL);
	
КонецФункции

