////////////////////////////////////////////////////////////////////////////////
// Общий модуль сервер: резервное копирование и восстановление данных Wallet.
// Формат файла: WalletBackup XML, версия 1.
// Облако: Google Drive (OAuth device code) или отправка копии на Gmail.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает сведения для экрана резервного копирования.
//
Функция СведенияОРезервномКопировании() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Email", СокрЛП(Константы.GoogleАккаунтEmail.Получить()));
	Результат.Вставить("ЕстьТокен", ОбщийМодульСервер_Безопасность.ЕстьТокеныGoogle());
	Результат.Вставить("ClientIdЗадан", ЗначениеЗаполнено(СокрЛП(Константы.GoogleOAuthClientId.Получить())));
	Результат.Вставить("ДатаЛокальнойКопии", Константы.ДатаПоследнейЛокальнойКопии.Получить());
	Результат.Вставить("ДатаОблачнойКопии", Константы.ДатаПоследнейОблачнойКопии.Получить());
	
	Возврат Результат;
	
КонецФункции

// Формирует файл резервной копии и помещает его во временное хранилище.
// Возвращает структуру: Успех, Текст, АдресВХранилище, ИмяФайла.
//
Функция СоздатьРезервнуюКопиюВХранилище(УникальныйИдентификаторФормы) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	ТекстXML = СформироватьТекстРезервнойКопии();
	
	Если Не ЗначениеЗаполнено(ТекстXML) Тогда
		
		Результат.Текст = "Не удалось сформировать резервную копию.";
		Возврат Результат;
		
	КонецЕсли;
	
	ИмяФайла = ИмяФайлаРезервнойКопии();
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстXML, КодировкаТекста.UTF8);
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторФормы);
	
	Константы.ДатаПоследнейЛокальнойКопии.Установить(ТекущаяДатаСеанса());
	
	Результат.Успех = Истина;
	Результат.Текст = "Резервная копия создана.";
	Результат.Вставить("АдресВХранилище", Адрес);
	Результат.Вставить("ИмяФайла", ИмяФайла);
	Результат.Вставить("ТекстXML", ТекстXML);
	
	Возврат Результат;
	
КонецФункции

// Проверяет корректность файла резервной копии.
//
Функция ПроверитьФайлРезервнойКопии(ТекстXML) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	Если Не ЗначениеЗаполнено(ТекстXML) Тогда
		
		Результат.Текст = "Файл резервной копии пуст.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если СтрНайти(ТекстXML, "<WalletBackup") = 0 Тогда
		
		Результат.Текст = "Это не файл резервной копии Wallet.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если СтрНайти(ТекстXML, "Version=""1""") = 0 И СтрНайти(ТекстXML, "Version='1'") = 0 Тогда
		
		Результат.Текст = "Неподдерживаемая версия файла резервной копии.";
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Текст = "Файл резервной копии корректный.";
	
	Возврат Результат;
	
КонецФункции

// Восстанавливает данные из текста XML резервной копии.
// Перед вызовом нужно получить подтверждение пользователя о замене данных.
//
Функция ВосстановитьИзТекстаXML(ТекстXML) Экспорт
	
	Результат = ПроверитьФайлРезервнойКопии(ТекстXML);
	
	Если Не Результат.Успех Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	ОчиститьДанныеПередВосстановлением();
	ЗагрузитьДанныеИзТекстаXML(ТекстXML);
	ПровестиЗагруженныеДокументы();
	
	Результат.Успех = Истина;
	Результат.Текст = "Данные успешно восстановлены из резервной копии.";
	
	Возврат Результат;
	
КонецФункции

// Восстанавливает данные из двоичных данных файла во временном хранилище.
//
Функция ВосстановитьИзХранилища(АдресВХранилище) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	Если Не ЭтоАдресВременногоХранилища(АдресВХранилище) Тогда
		
		Результат.Текст = "Не удалось получить файл резервной копии.";
		Возврат Результат;
		
	КонецЕсли;
	
	Данные = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		
		ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
		
	ИначеЕсли ТипЗнч(Данные) = Тип("Строка") Тогда
		
		ТекстXML = Данные;
		
	Иначе
		
		Результат.Текст = "Неизвестный формат файла резервной копии.";
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат ВосстановитьИзТекстаXML(ТекстXML);
	
КонецФункции

// Отключает Google-аккаунт: очищает email и токены (пароль не хранится).
//
Процедура ОтключитьGoogleАккаунт() Экспорт
	
	Константы.GoogleАккаунтEmail.Установить("");
	ОбщийМодульСервер_Безопасность.ОчиститьТокеныGoogle();
	Константы.GoogleТокенИстекает.Установить('00010101');
	
КонецПроцедуры

// Сохраняет результат нативного Google Sign-In (внешняя компонента на Android).
// Пароль не передаётся и не хранится — только email и OAuth-токены.
//
Процедура СохранитьРезультатНативногоВхода(Email, AccessToken, RefreshToken = "", ExpiresIn = 3600) Экспорт
	
	Константы.GoogleАккаунтEmail.Установить(СокрЛП(Email));
	
	Если ЗначениеЗаполнено(AccessToken) Тогда
		
		ОбщийМодульСервер_Безопасность.СохранитьТокеныGoogle(AccessToken, RefreshToken);
		
		Срок = Число(ExpiresIn);
		
		Если Срок < 60 Тогда
			
			Срок = 3600;
			
		КонецЕсли;
		
		Константы.GoogleТокенИстекает.Установить(ТекущаяДатаСеанса() + Срок - 60);
		
	КонецЕсли;
	
КонецПроцедуры

// Сохраняет email Google-аккаунта без OAuth (режим отправки на Gmail).
//
Процедура СохранитьGoogleEmail(Email) Экспорт
	
	Константы.GoogleАккаунтEmail.Установить(СокрЛП(Email));
	
КонецПроцедуры

// Сохраняет OAuth Client ID приложения.
//
Процедура СохранитьGoogleOAuthClientId(ClientId) Экспорт
	
	Константы.GoogleOAuthClientId.Установить(СокрЛП(ClientId));
	
КонецПроцедуры

// Запускает Device Code авторизацию Google. Возвращает user_code и verification_url.
//
Функция НачатьАвторизациюGoogle() Экспорт
	
	Результат = НовыйРезультатОперации();
	ClientId = СокрЛП(Константы.GoogleOAuthClientId.Получить());
	
	Если Не ЗначениеЗаполнено(ClientId) Тогда
		
		Результат.Текст = "Сначала укажите Google OAuth Client ID в настройках резервного копирования.";
		Возврат Результат;
		
	КонецЕсли;
	
	Тело = "client_id=" + КодироватьСтроку(ClientId, СпособКодированияСтроки.КодировкаURL)
		+ "&scope=" + КодироватьСтроку(
			"https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email",
			СпособКодированияСтроки.КодировкаURL);
	
	ОтветHTTP = ВыполнитьHTTPЗапрос("oauth2.googleapis.com", "/device/code", "POST", Тело,
		"application/x-www-form-urlencoded", "");
	
	Если Не ОтветHTTP.Успех Тогда
		
		Результат.Текст = ОтветHTTP.Текст;
		Возврат Результат;
		
	КонецЕсли;
	
	Данные = ПрочитатьJSONОбъект(ОтветHTTP.Тело);
	
	Если Данные = Неопределено Или Не Данные.Свойство("device_code") Тогда
		
		Результат.Текст = "Google не вернул код авторизации. Проверьте Client ID (тип: TV / Limited Input).";
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Текст = "Откройте ссылку и введите код.";
	Результат.Вставить("DeviceCode", Данные.device_code);
	Результат.Вставить("UserCode", Данные.user_code);
	Результат.Вставить("VerificationUrl", ?(Данные.Свойство("verification_url"), Данные.verification_url,
		"https://www.google.com/device"));
	Результат.Вставить("Interval", ?(Данные.Свойство("interval"), Число(Данные.interval), 5));
	Результат.Вставить("ExpiresIn", ?(Данные.Свойство("expires_in"), Число(Данные.expires_in), 1800));
	
	Возврат Результат;
	
КонецФункции

// Опрашивает Google на наличие токена после device code авторизации.
// Статусы: Успех / Ожидание / Ошибка.
//
Функция ПроверитьАвторизациюGoogle(DeviceCode) Экспорт
	
	Результат = НовыйРезультатОперации();
	Результат.Вставить("Статус", "Ошибка");
	ClientId = СокрЛП(Константы.GoogleOAuthClientId.Получить());
	
	Тело = "client_id=" + КодироватьСтроку(ClientId, СпособКодированияСтроки.КодировкаURL)
		+ "&device_code=" + КодироватьСтроку(DeviceCode, СпособКодированияСтроки.КодировкаURL)
		+ "&grant_type=" + КодироватьСтроку("urn:ietf:params:oauth:grant-type:device_code",
			СпособКодированияСтроки.КодировкаURL);
	
	ОтветHTTP = ВыполнитьHTTPЗапрос("oauth2.googleapis.com", "/token", "POST", Тело,
		"application/x-www-form-urlencoded", "");
	
	Данные = ПрочитатьJSONОбъект(ОтветHTTP.Тело);
	
	Если Данные <> Неопределено И Данные.Свойство("error") Тогда
		
		КодОшибки = Строка(Данные.error);
		
		Если КодОшибки = "authorization_pending" Или КодОшибки = "slow_down" Тогда
			
			Результат.Успех = Истина;
			Результат.Статус = "Ожидание";
			Результат.Текст = "Ожидание подтверждения в браузере…";
			Возврат Результат;
			
		ИначеЕсли КодОшибки = "access_denied" Тогда
			
			Результат.Статус = "Ошибка";
			Результат.Текст = "Авторизация Google отменена.";
			Возврат Результат;
			
		ИначеЕсли КодОшибки = "expired_token" Тогда
			
			Результат.Статус = "Ошибка";
			Результат.Текст = "Время ожидания авторизации истекло. Начните подключение снова.";
			Возврат Результат;
			
		Иначе
			
			Результат.Текст = "Ошибка авторизации Google: " + КодОшибки;
			Возврат Результат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Данные = Неопределено Или Не Данные.Свойство("access_token") Тогда
		
		Результат.Текст = ?(ЗначениеЗаполнено(ОтветHTTP.Текст), ОтветHTTP.Текст,
			"Не удалось получить токен Google.");
		Возврат Результат;
		
	КонецЕсли;
	
	СохранитьТокеныGoogle(Данные);
	Email = ПолучитьEmailПользователяGoogle();
	
	Если ЗначениеЗаполнено(Email) Тогда
		
		Константы.GoogleАккаунтEmail.Установить(Email);
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Статус = "Успех";
	Результат.Текст = "Google-аккаунт подключён"
		+ ?(ЗначениеЗаполнено(Email), ": " + Email, ".");
	
	Возврат Результат;
	
КонецФункции

// Загружает резервную копию в Google Drive. При отсутствии токена — готовит данные для Gmail.
// Возвращает: Успех, Текст, Режим (Drive|Gmail), АдресВХранилище, ИмяФайла.
//
Функция СоздатьОблачнуюРезервнуюКопию(УникальныйИдентификаторФормы) Экспорт
	
	Результат = СоздатьРезервнуюКопиюВХранилище(УникальныйИдентификаторФормы);
	
	Если Не Результат.Успех Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Если ОбеспечитьАктуальныйAccessToken() Тогда
		
		Загрузка = ЗагрузитьФайлНаGoogleDrive(Результат.ИмяФайла, Результат.ТекстXML);
		
		Если Загрузка.Успех Тогда
			
			Константы.ДатаПоследнейОблачнойКопии.Установить(ТекущаяДатаСеанса());
			Результат.Текст = "Резервная копия загружена в Google Drive.";
			Результат.Вставить("Режим", "Drive");
			Возврат Результат;
			
		КонецЕсли;
		
		Результат.Успех = Ложь;
		Результат.Текст = Загрузка.Текст;
		Результат.Вставить("Режим", "Drive");
		Возврат Результат;
		
	КонецЕсли;
	
	Email = СокрЛП(Константы.GoogleАккаунтEmail.Получить());
	
	Если Не ЗначениеЗаполнено(Email) Тогда
		
		Результат.Успех = Ложь;
		Результат.Текст = "Подключите Google-аккаунт или укажите Gmail для отправки копии.";
		Результат.Вставить("Режим", "");
		Возврат Результат;
		
	КонецЕсли;
	
	Константы.ДатаПоследнейОблачнойКопии.Установить(ТекущаяДатаСеанса());
	Результат.Текст = "Откройте почтовый клиент и отправьте копию на " + Email + ".";
	Результат.Вставить("Режим", "Gmail");
	Результат.Вставить("Email", Email);
	
	Возврат Результат;
	
КонецФункции

// Возвращает список файлов резервных копий на Google Drive.
//
Функция СписокРезервныхКопийНаGoogleDrive() Экспорт
	
	Результат = НовыйРезультатОперации();
	Результат.Вставить("Файлы", Новый Массив);
	
	Если Не ОбеспечитьАктуальныйAccessToken() Тогда
		
		Результат.Текст = "Нет доступа к Google Drive. Подключите аккаунт через OAuth.";
		Возврат Результат;
		
	КонецЕсли;
	
	Запрос = "/drive/v3/files?pageSize=20&orderBy=createdTime desc&fields=files(id,name,createdTime,size)"
		+ "&q=" + КодироватьСтроку(
			"name contains 'WalletBackup' and trashed = false",
			СпособКодированияСтроки.КодировкаURL);
	
	ОтветHTTP = ВыполнитьHTTPЗапрос("www.googleapis.com", Запрос, "GET", "", "",
		ОбщийМодульСервер_Безопасность.ПолучитьGoogleAccessToken());
	
	Если Не ОтветHTTP.Успех Тогда
		
		Результат.Текст = ОтветHTTP.Текст;
		Возврат Результат;
		
	КонецЕсли;
	
	Данные = ПрочитатьJSONОбъект(ОтветHTTP.Тело);
	
	Если Данные = Неопределено Тогда
		
		Результат.Текст = "Не удалось прочитать список файлов Google Drive.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если Данные.Свойство("files") Тогда
		
		Для Каждого Файл Из Данные.files Цикл
			
			СтрокаФайла = Новый Структура;
			СтрокаФайла.Вставить("Id", Файл.id);
			СтрокаФайла.Вставить("Имя", Файл.name);
			СтрокаФайла.Вставить("Дата", ?(Файл.Свойство("createdTime"), Файл.createdTime, ""));
			Результат.Файлы.Добавить(СтрокаФайла);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Текст = ?(Результат.Файлы.Количество() = 0,
		"На Google Drive пока нет резервных копий Wallet.",
		"Найдено копий: " + Формат(Результат.Файлы.Количество(), "ЧГ=0"));
	
	Возврат Результат;
	
КонецФункции

// Скачивает файл с Google Drive и восстанавливает данные.
//
Функция ВосстановитьИзGoogleDrive(ИдентификаторФайла) Экспорт
	
	Результат = НовыйРезультатОперации();
	
	Если Не ОбеспечитьАктуальныйAccessToken() Тогда
		
		Результат.Текст = "Нет доступа к Google Drive. Подключите аккаунт через OAuth.";
		Возврат Результат;
		
	КонецЕсли;
	
	ОтветHTTP = ВыполнитьHTTPЗапрос("www.googleapis.com",
		"/drive/v3/files/" + ИдентификаторФайла + "?alt=media",
		"GET", "", "", ОбщийМодульСервер_Безопасность.ПолучитьGoogleAccessToken());
	
	Если Не ОтветHTTP.Успех Тогда
		
		Результат.Текст = ОтветHTTP.Текст;
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат ВосстановитьИзТекстаXML(ОтветHTTP.Тело);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатОперации()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	
	Возврат Результат;
	
КонецФункции

Функция ИмяФайлаРезервнойКопии()
	
	Возврат "WalletBackup_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + ".xml";
	
КонецФункции

Функция СформироватьТекстРезервнойКопии()
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("WalletBackup");
	ЗаписьXML.ЗаписатьАтрибут("Version", "1");
	ЗаписьXML.ЗаписатьАтрибут("Created", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	ЗаписьXML.ЗаписатьАтрибут("App", "Wallet");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Constants");
	ЗаписатьКонстантуВXML(ЗаписьXML, "ВалютаУчета", Константы.ВалютаУчета.Получить());
	ЗаписатьКонстантуВXML(ЗаписьXML, "ПервыйЗапуск", Константы.ПервыйЗапуск.Получить());
	ЗаписатьКонстантуВXML(ЗаписьXML, "АвтообновлениеКурсовВалют",
		Константы.АвтообновлениеКурсовВалют.Получить());
	ЗаписатьКонстантуВXML(ЗаписьXML, "GoogleАккаунтEmail", Константы.GoogleАккаунтEmail.Получить());
	ЗаписатьКонстантуВXML(ЗаписьXML, "ТемаПриложения", Константы.ТемаПриложения.Получить());
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Constants
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Catalogs");
	ВыгрузитьСправочникВXML(ЗаписьXML, "Валюта", Справочники.Валюта);
	ВыгрузитьСправочникВXML(ЗаписьXML, "КатегорииДоходов", Справочники.КатегорииДоходов);
	ВыгрузитьСправочникВXML(ЗаписьXML, "КатегорииРасходов", Справочники.КатегорииРасходов);
	ВыгрузитьСправочникВXML(ЗаписьXML, "Счета", Справочники.Счета);
	ВыгрузитьСправочникВXML(ЗаписьXML, "Контакты", Справочники.Контакты);
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Catalogs
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Documents");
	ВыгрузитьДокументыВXML(ЗаписьXML, "Доходы", Документы.Доходы);
	ВыгрузитьДокументыВXML(ЗаписьXML, "Расход", Документы.Расход);
	ВыгрузитьДокументыВXML(ЗаписьXML, "Переводы", Документы.Переводы);
	ВыгрузитьДокументыВXML(ЗаписьXML, "ПередачаСредствВДолг", Документы.ПередачаСредствВДолг);
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Documents
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("InformationRegisters");
	ВыгрузитьНаборЗаписейВXML(ЗаписьXML, "КурсыВалют", РегистрыСведений.КурсыВалют.СоздатьНаборЗаписей());
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	// Движения РН восстанавливаются проведением документов после загрузки.
	ЗаписьXML.ЗаписатьКонецЭлемента(); // WalletBackup
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

