#Область ПрограммныйИнтерфейс

// Возвращает признак завершения начальной настройки приложения.
// Истина — валюта учёта уже сохранена, повторный показ формы настроек не нужен.
// Соответствует константе ПервыйЗапуск (синоним: «Начальная настройка выполнена»).
//
Функция НачальнаяНастройкаВыполнена() Экспорт
	
	Возврат Константы.ПервыйЗапуск.Получить();
	
КонецФункции

// Совместимость со старым именем API (до переименования на НачальнаяНастройкаВыполнена).
//
Функция ПолучитьПараметрЗапуска() Экспорт
	
	Возврат НачальнаяНастройкаВыполнена();
	
КонецФункции

// Устанавливает признак завершения начальной настройки.
//
Процедура УстановитьНачальнаяНастройкаВыполнена(Выполнена = Истина) Экспорт
	
	Константы.ПервыйЗапуск.Установить(Выполнена);
	
КонецПроцедуры

// Совместимость со старым именем API (до переименования на УстановитьНачальнаяНастройкаВыполнена).
//
Процедура ПрошелПервыйЗапуск() Экспорт
	
	УстановитьНачальнаяНастройкаВыполнена(Истина);
	
КонецПроцедуры

// Возвращает валюту учёта из константы.
//
Функция ПолучитьВалютуРегламентированногоУчета() Экспорт
	
	Возврат Константы.ВалютаУчета.Получить();
	
КонецФункции

// Валюта по умолчанию для онбординга: по коду локализации, иначе KZT.
//
Функция ВалютаПоУмолчаниюПоРегиону() Экспорт
	
	КодЛокали = "";
	
	Попытка
		
		КодЛокали = ВРег(Строка(ТекущийКодЛокализации()));
		
	Исключение
		
		КодЛокали = "";
		
	КонецПопытки;
	
	Если СтрНайти(КодЛокали, "KZ") > 0 Тогда
		
		Возврат Справочники.Валюта.Тенге;
		
	ИначеЕсли СтрНайти(КодЛокали, "RU") > 0 Тогда
		
		Возврат Справочники.Валюта.Рубль;
		
	ИначеЕсли СтрНайти(КодЛокали, "US") > 0 Или СтрНайти(КодЛокали, "EN") > 0 Тогда
		
		Возврат Справочники.Валюта.ДолларСША;
		
	ИначеЕсли СтрНайти(КодЛокали, "EU") > 0 Или СтрНайти(КодЛокали, "DE") > 0 Или СтрНайти(КодЛокали, "FR") > 0 Тогда
		
		Возврат Справочники.Валюта.Евро;
		
	КонецЕсли;
	
	Возврат Справочники.Валюта.Тенге;
	
КонецФункции

// Пропуск онбординга: валюта по умолчанию (или переданная), без начального остатка.
//
Функция ПропуститьПервыйЗапуск(Валюта = Неопределено) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		
		Валюта = ВалютаПоУмолчаниюПоРегиону();
		
	КонецЕсли;
	
	Константы.ВалютаУчета.Установить(Валюта);
	
	Если Не ЗначениеЗаполнено(Константы.ТемаПриложения.Получить()) Тогда
		
		Константы.ТемаПриложения.Установить("Системная");
		
	КонецЕсли;
	
	ЗаполнитьПредопределенныеКошелькиНаСервере();
	УстановитьНачальнаяНастройкаВыполнена(Истина);
	
	Результат.Успех = Истина;
	Результат.Текст = "Можно начинать учёт.";
	
	Возврат Результат;
	
КонецФункции

// Завершение онбординга: валюта, стартовый счёт и опциональный начальный остаток.
// ТипСчета: cash | card | bank | kaspi | other
//
Функция ЗавершитьПервыйЗапуск(Валюта, ТипСчета, ИмяСчета, НачальныйОстаток = 0) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		
		Результат.Текст = "Не выбрана основная валюта.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СокрЛП(ИмяСчета)) Тогда
		
		Результат.Текст = "Укажите название счёта.";
		Возврат Результат;
		
	КонецЕсли;
	
	Константы.ВалютаУчета.Установить(Валюта);
	
	Если Не ЗначениеЗаполнено(Константы.ТемаПриложения.Получить()) Тогда
		
		Константы.ТемаПриложения.Установить("Системная");
		
	КонецЕсли;
	
	ЗаполнитьПредопределенныеКошелькиНаСервере();
	Счет = ОбеспечитьСтартовыйСчет(ТипСчета, СокрЛП(ИмяСчета));
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		
		Результат.Текст = "Не удалось создать стартовый счёт.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если НачальныйОстаток > 0 Тогда
		
		СоздатьДокументНачальногоОстатка(Счет, Валюта, НачальныйОстаток);
		
	КонецЕсли;
	
	УстановитьНачальнаяНастройкаВыполнена(Истина);
	
	Результат.Успех = Истина;
	Результат.Текст = "Настройка завершена.";
	
	Возврат Результат;
	
КонецФункции

// Возвращает сведения для экрана настроек.
//
Функция СведенияДляЭкранаНастроек() Экспорт
	
	Валюта = Константы.ВалютаУчета.Получить();
	Тема = СокрЛП(Константы.ТемаПриложения.Получить());
	
	Если Не ЗначениеЗаполнено(Тема) Тогда
		
		Тема = "Системная";
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ВалютаПредставление", ?(ЗначениеЗаполнено(Валюта), Строка(Валюта), "не задана"));
	Результат.Вставить("Тема", Тема);
	Результат.Вставить("ТемаПредставление", ПредставлениеТемы(Тема));
	Результат.Вставить("Версия", Метаданные.Версия);
	
	Возврат Результат;
	
КонецФункции

// Циклически переключает тему: Светлая → Тёмная → Системная.
//
Функция ПереключитьТемуПриложения() Экспорт
	
	Текущая = СокрЛП(Константы.ТемаПриложения.Получить());
	
	Если Текущая = "Светлая" Тогда
		
		НоваяТема = "Тёмная";
		
	ИначеЕсли Текущая = "Тёмная" Тогда
		
		НоваяТема = "Системная";
		
	Иначе
		
		НоваяТема = "Светлая";
		
	КонецЕсли;
	
	Константы.ТемаПриложения.Установить(НоваяТема);
	
	Возврат НоваяТема;
	
КонецФункции

// Признак тёмной темы для HTML-экранов.
//
Функция ИспользоватьТемнуюТему() Экспорт
	
	Тема = СокрЛП(Константы.ТемаПриложения.Получить());
	
	Возврат Тема = "Тёмная";
	
КонецФункции

// Заполняет вид и наименование предопределённых счетов.
// Идемпотентно: пишет только при отличии значений.
//
Процедура ЗаполнитьПредопределенныеКошелькиНаСервере() Экспорт
	
	СоответствиеВидов = СоответствиеПредопределенныхСчетовИВидов();
	СоответствиеНаименований = СоответствиеПредопределенныхСчетовИНаименований();
	
	Для Каждого ЭлементСоответствия Из СоответствиеВидов Цикл
		
		СпрОбъект = Справочники.Счета[ЭлементСоответствия.Ключ].ПолучитьОбъект();
		ТребуетсяЗапись = Ложь;
		
		Если СпрОбъект.ВидСчета <> ЭлементСоответствия.Значение Тогда
			
			СпрОбъект.ВидСчета = ЭлементСоответствия.Значение;
			ТребуетсяЗапись = Истина;
			
		КонецЕсли;
		
		НовоеНаименование = СоответствиеНаименований.Получить(ЭлементСоответствия.Ключ);
		
		Если ЗначениеЗаполнено(НовоеНаименование) И СпрОбъект.Наименование <> НовоеНаименование Тогда
			
			СпрОбъект.Наименование = НовоеНаименование;
			ТребуетсяЗапись = Истина;
			
		КонецЕсли;
		
		Если ТребуетсяЗапись Тогда
			
			СпрОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоответствиеПредопределенныхСчетовИВидов()
	
	Результат = Новый Соответствие;
	Результат.Вставить("БанковскийСчет", Перечисления.ВидСчета.БанковскийСчет);
	Результат.Вставить("Карта", Перечисления.ВидСчета.БанковскаяКарта);
	Результат.Вставить("Кошелек", Перечисления.ВидСчета.Кошелек);
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеПредопределенныхСчетовИНаименований()
	
	Результат = Новый Соответствие;
	Результат.Вставить("БанковскийСчет", "Банковский счёт");
	Результат.Вставить("Карта", "Банковская карта");
	Результат.Вставить("Кошелек", "Наличные");
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеТемы(Тема)
	
	Если Тема = "Светлая" Тогда
		
		Возврат "Светлая";
		
	ИначеЕсли Тема = "Тёмная" Тогда
		
		Возврат "Тёмная";
		
	КонецЕсли;
	
	Возврат "Системная";
	
КонецФункции

Функция ОбеспечитьСтартовыйСчет(ТипСчета, ИмяСчета)
	
	Если ТипСчета = "cash" Тогда
		
		СчетОбъект = Справочники.Счета.Кошелек.ПолучитьОбъект();
		СчетОбъект.Наименование = ИмяСчета;
		СчетОбъект.ВидСчета = Перечисления.ВидСчета.Кошелек;
		СчетОбъект.Записать();
		
		Возврат СчетОбъект.Ссылка;
		
	ИначеЕсли ТипСчета = "card" Тогда
		
		СчетОбъект = Справочники.Счета.Карта.ПолучитьОбъект();
		СчетОбъект.Наименование = ИмяСчета;
		СчетОбъект.ВидСчета = Перечисления.ВидСчета.БанковскаяКарта;
		СчетОбъект.Записать();
		
		Возврат СчетОбъект.Ссылка;
		
	ИначеЕсли ТипСчета = "bank" Тогда
		
		СчетОбъект = Справочники.Счета.БанковскийСчет.ПолучитьОбъект();
		СчетОбъект.Наименование = ИмяСчета;
		СчетОбъект.ВидСчета = Перечисления.ВидСчета.БанковскийСчет;
		СчетОбъект.Записать();
		
		Возврат СчетОбъект.Ссылка;
		
	КонецЕсли;
	
	ВидСчета = Перечисления.ВидСчета.БанковскаяКарта;
	
	Если ТипСчета = "other" Тогда
		
		ВидСчета = Перечисления.ВидСчета.Кошелек;
		
	КонецЕсли;
	
	Найденный = Справочники.Счета.НайтиПоНаименованию(ИмяСчета, Истина);
	
	Если ЗначениеЗаполнено(Найденный) Тогда
		
		СчетОбъект = Найденный.ПолучитьОбъект();
		СчетОбъект.ВидСчета = ВидСчета;
		СчетОбъект.Записать();
		
		Возврат СчетОбъект.Ссылка;
		
	КонецЕсли;
	
	СчетОбъект = Справочники.Счета.СоздатьЭлемент();
	СчетОбъект.Наименование = ИмяСчета;
	СчетОбъект.ВидСчета = ВидСчета;
	СчетОбъект.Записать();
	
	Возврат СчетОбъект.Ссылка;
	
КонецФункции

Процедура СоздатьДокументНачальногоОстатка(Счет, Валюта, СуммаОстатка)
	
	ДокументОбъект = Документы.Доходы.СоздатьДокумент();
	ДокументОбъект.Дата = НачалоДня(ТекущаяДатаСеанса());
	ДокументОбъект.Счет = Счет;
	ДокументОбъект.Валюта = Валюта;
	ДокументОбъект.Сумма = СуммаОстатка;
	ДокументОбъект.КатегорияДоходов = Справочники.КатегорииДоходов.ПрочийДоход;
	ДокументОбъект.Комментарий = "Начальный остаток";
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

#КонецОбласти
