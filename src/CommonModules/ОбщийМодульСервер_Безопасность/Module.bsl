КонецФункции

Функция КоличествоИзЗапроса(Запрос)
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат ?(Выборка.Количество = Null, 0, Выборка.Количество);
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПрочитатьТокеныGoogleИзХранилища()
	
	Результат = Новый Структура("Access, Refresh", "", "");
	Хранилище = Константы.GoogleТокеныХранилище.Получить();
	
	Если Хранилище = Неопределено Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Данные = Хранилище.Получить();
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Если Данные.Свойство("Access") Тогда
		
		Результат.Access = СокрЛП(Строка(Данные.Access));
		
	КонецЕсли;
	
	Если Данные.Свойство("Refresh") Тогда
		
		Результат.Refresh = СокрЛП(Строка(Данные.Refresh));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура МигрироватьТокеныGoogleИзСтроковыхКонстант()
	
	СтарыйAccess = СокрЛП(Константы.GoogleAccessToken.Получить());
	СтарыйRefresh = СокрЛП(Константы.GoogleRefreshToken.Получить());
	
	Если Не ЗначениеЗаполнено(СтарыйAccess) И Не ЗначениеЗаполнено(СтарыйRefresh) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Текущие = ПрочитатьТокеныGoogleИзХранилища();
	Access = ?(ЗначениеЗаполнено(Текущие.Access), Текущие.Access, СтарыйAccess);
	Refresh = ?(ЗначениеЗаполнено(Текущие.Refresh), Текущие.Refresh, СтарыйRefresh);
	СохранитьТокеныGoogle(Access, Refresh);
	
КонецПроцедуры

#КонецОбласти
