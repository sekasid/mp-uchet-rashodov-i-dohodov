#Область ПрограммныйИнтерфейс

// Признак включённого PIN-кода (есть хеш и флаг).
//
Функция ПинВключен() Экспорт
	
	Возврат Константы.ИспользоватьПИН.Получить() И ЗначениеЗаполнено(Константы.ХешПИН.Получить());
	
КонецФункции

// Нужно показать форму разблокировки при старте.
//
Функция ТребуетсяРазблокировка() Экспорт
	
	Возврат ПинВключен();
	
КонецФункции

// Биометрия включена в настройках.
//
Функция БиометрияВключена() Экспорт
	
	Возврат Константы.ИспользоватьБиометрию.Получить() И ПинВключен();
	
КонецФункции

// Сведения для экрана безопасности.
//
Функция СведенияДляЭкранаБезопасности() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПинВключен", ПинВключен());
	Результат.Вставить("БиометрияВключена", Константы.ИспользоватьБиометрию.Получить());
	Результат.Вставить("СкрыватьСуммы", Константы.СкрыватьСуммы.Получить());
	
	Возврат Результат;
	
КонецФункции

// Проверяет PIN. Возвращает структуру Успех, Текст.
//
Функция ПроверитьПИН(ПИН) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Код = СокрЛП(Строка(ПИН));
	
	Если Не ПинВключен() Тогда
		
		Результат.Успех = Истина;
		Возврат Результат;
		
	КонецЕсли;
	
	Если СтрДлина(Код) < 4 Или СтрДлина(Код) > 6 Тогда
		
		Результат.Текст = "Введите PIN из 4–6 цифр.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если ХешПИНКода(Код) <> Константы.ХешПИН.Получить() Тогда
		
		Результат.Текст = "Неверный PIN-код.";
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает новый PIN (4–6 цифр). Требует совпадения Подтверждение.
//
Функция УстановитьПИН(ПИН, Подтверждение) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Код = СокрЛП(Строка(ПИН));
	ПодтверждениеКод = СокрЛП(Строка(Подтверждение));
	
	Если СтрДлина(Код) < 4 Или СтрДлина(Код) > 6 Или Не ТолькоЦифры(Код) Тогда
		
		Результат.Текст = "PIN должен содержать 4–6 цифр.";
		Возврат Результат;
		
	КонецЕсли;
	
	Если Код <> ПодтверждениеКод Тогда
		
		Результат.Текст = "Коды не совпадают. Повторите ввод.";
		Возврат Результат;
		
	КонецЕсли;
	
	Константы.ХешПИН.Установить(ХешПИНКода(Код));
	Константы.ИспользоватьПИН.Установить(Истина);
	
	Результат.Успех = Истина;
	Результат.Текст = "PIN-код включён.";
	
	Возврат Результат;
	
КонецФункции

// Отключает PIN после проверки текущего кода.
//
Функция ОтключитьПИН(ПИН) Экспорт
	
	Результат = ПроверитьПИН(ПИН);
	
	Если Не Результат.Успех Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Константы.ИспользоватьПИН.Установить(Ложь);
	Константы.ХешПИН.Установить("");
	Константы.ИспользоватьБиометрию.Установить(Ложь);
	
	Результат.Текст = "PIN-код отключён.";
	
	Возврат Результат;
	
КонецФункции

// Включает/выключает биометрию (только при активном PIN).
//
Функция УстановитьБиометрию(Включить) Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	
	Если Включить И Не ПинВключен() Тогда
		
		Результат.Текст = "Сначала включите PIN-код.";
		Возврат Результат;
		
	КонецЕсли;
	
	Константы.ИспользоватьБиометрию.Установить(Включить);
	Результат.Успех = Истина;
	Результат.Текст = ?(Включить, "Биометрия включена.", "Биометрия выключена.");
	
	Возврат Результат;
	
КонецФункции

