// Текст подтверждения удаления с учётом использования объекта.
//
Функция ТекстПодтвержденияУдаления(Ссылка) Экспорт
	
	Сведения = СведенияОбИспользовании(Ссылка);
	Имя = Строка(Ссылка);
	
	Если Сведения.Количество = 0 Тогда
		
		Возврат "Удалить «" + Имя + "»? Объект будет помечен на удаление.";
		
	КонецЕсли;
	
	Возврат "«" + Имя + "» используется в " + Формат(Сведения.Количество, "ЧГ=0") + " "
		+ Сведения.Подпись + ". Удалить (пометить на удаление)?";
	
КонецФункции

// Количество ссылок/движений по объекту.
//
Функция СведенияОбИспользовании(Ссылка) Экспорт
	
	Результат = Новый Структура("Количество, Подпись", 0, "операциях");
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	ТипСсылки = ТипЗнч(Ссылка);
	
	Если ТипСсылки = Тип("СправочникСсылка.Счета") Тогда
		
		Результат.Количество = КоличествоДокументовПоСчету(Ссылка);
		Результат.Подпись = ПодписьКоличества(Результат.Количество, "операции", "операциях", "операциях");
		
	ИначеЕсли ТипСсылки = Тип("СправочникСсылка.КатегорииДоходов") Тогда
		
		Результат.Количество = КоличествоДокументовПоКатегорииДоходов(Ссылка);
		Результат.Подпись = ПодписьКоличества(Результат.Количество, "документе", "документах", "документах");
		
	ИначеЕсли ТипСсылки = Тип("СправочникСсылка.КатегорииРасходов") Тогда
		
		Результат.Количество = КоличествоДокументовПоКатегорииРасходов(Ссылка);
		Результат.Подпись = ПодписьКоличества(Результат.Количество, "документе", "документах", "документах");
		
	ИначеЕсли ТипСсылки = Тип("СправочникСсылка.Контакты") Тогда
		
		Результат.Количество = КоличествоДокументовПоКонтакту(Ссылка);
		Результат.Подпись = ПодписьКоличества(Результат.Количество, "документе", "документах", "документах");
		
	ИначеЕсли ТипСсылки = Тип("СправочникСсылка.Валюта") Тогда
		
		Результат.Количество = КоличествоДокументовПоВалюте(Ссылка);
		Результат.Подпись = ПодписьКоличества(Результат.Количество, "документе", "документах", "документах");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// --- Google-токены (ValueStorage + миграция со старых строковых констант) ---

Функция ЕстьТокеныGoogle() Экспорт
	
	МигрироватьТокеныGoogleИзСтроковыхКонстант();
	Токены = ПрочитатьТокеныGoogleИзХранилища();
	
	Возврат ЗначениеЗаполнено(Токены.Access) Или ЗначениеЗаполнено(Токены.Refresh);
	
КонецФункции

Функция ПолучитьGoogleAccessToken() Экспорт
	
	МигрироватьТокеныGoogleИзСтроковыхКонстант();
	
	Возврат ПрочитатьТокеныGoogleИзХранилища().Access;
	
КонецФункции

Функция ПолучитьGoogleRefreshToken() Экспорт
	
	МигрироватьТокеныGoogleИзСтроковыхКонстант();
	
	Возврат ПрочитатьТокеныGoogleИзХранилища().Refresh;
	
КонецФункции

Процедура СохранитьТокеныGoogle(AccessToken, RefreshToken = "") Экспорт
	
	Текущие = ПрочитатьТокеныGoogleИзХранилища();
	Access = СокрЛП(Строка(AccessToken));
	Refresh = СокрЛП(Строка(RefreshToken));
	
	Если Не ЗначениеЗаполнено(Refresh) Тогда
		
		Refresh = Текущие.Refresh;
		
	КонецЕсли;
	
	Данные = Новый Структура("Access, Refresh", Access, Refresh);
	Константы.GoogleТокеныХранилище.Установить(Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(9)));
	Константы.GoogleAccessToken.Установить("");
	Константы.GoogleRefreshToken.Установить("");
	
КонецПроцедуры

Процедура ОчиститьТокеныGoogle() Экспорт
	
	Константы.GoogleТокеныХранилище.Установить(Новый ХранилищеЗначения(Неопределено));
	Константы.GoogleAccessToken.Установить("");
	Константы.GoogleRefreshToken.Установить("");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ХешПИНКода(ПИН)
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить("Wallet.PIN.v1|" + ПИН);
	
	Возврат Base64Строка(Хеширование.ХешСумма);
	
КонецФункции

Функция ТолькоЦифры(СтрокаПроверки)
	
	Для Индекс = 1 По СтрДлина(СтрокаПроверки) Цикл
		
		Символ = Сред(СтрокаПроверки, Индекс, 1);
		
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПодписьКоличества(Количество, Форма1, Форма2, Форма5)
	
	Остаток100 = Количество % 100;
	Остаток10 = Количество % 10;
	
	Если Остаток100 >= 11 И Остаток100 <= 14 Тогда
		
		Возврат Форма5;
		
	ИначеЕсли Остаток10 = 1 Тогда
		
		Возврат Форма1;
		
	ИначеЕсли Остаток10 >= 2 И Остаток10 <= 4 Тогда
		
		Возврат Форма2;
		
	КонецЕсли;
	
	Возврат Форма5;
	
КонецФункции

Функция КоличествоДокументовПоСчету(Счет)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Вложенный.Ссылка) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		Доходы.Ссылка КАК Ссылка
	|	ИЗ
	|		Документ.Доходы КАК Доходы
	|	ГДЕ
	|		Доходы.Счет = &Счет
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Расход.Ссылка
	|	ИЗ
	|		Документ.Расход КАК Расход
	|	ГДЕ
	|		Расход.Счет = &Счет
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Переводы.Ссылка
	|	ИЗ
	|		Документ.Переводы КАК Переводы
	|	ГДЕ
	|		Переводы.СчетИсточник = &Счет
	|		ИЛИ Переводы.СчетПолучатель = &Счет
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Долги.Ссылка
	|	ИЗ
	|		Документ.ПередачаСредствВДолг КАК Долги
	|	ГДЕ
	|		Долги.Счет = &Счет) КАК Вложенный";
	Запрос.УстановитьПараметр("Счет", Счет);
	
	Возврат КоличествоИзЗапроса(Запрос);
	
КонецФункции

Функция КоличествоДокументовПоКатегорииДоходов(Категория)
	
