////////////////////////////////////////////////////////////////////////////////
// Клиентский модуль: нативный Google Sign-In для мобильного приложения.
// Целевой UX: кнопка Google → системный выбор аккаунта Android.
// Реализация нативного picker — во внешней компоненте (см. docs/mobile/).
// Пока компонента не подключена в сборку МП, возвращается статус «Недоступно».
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Имя объекта внешней компоненты после ПодключитьВнешнююКомпоненту.
//
Функция ИмяОбъектаКомпоненты() Экспорт
	
	Возврат "AddIn.WalletGoogleSignIn.GoogleSignIn";
	
КонецФункции

// Имя макета конфигурации типа «Внешняя компонента» (после добавления в EDT).
//
Функция ИмяМакетаКомпоненты() Экспорт
	
	Возврат "ОбщийМакет.WalletGoogleSignIn";
	
КонецФункции

// Проверяет, доступен ли нативный Google Sign-In (компонента в сборке МП).
//
Функция НативныйВходДоступен() Экспорт
	
	Возврат КомпонентаПодключена();
	
КонецФункции

// Запускает системный выбор Google-аккаунта через внешнюю компоненту.
// Результат приходит во ВнешнееСобытие (см. ОбработатьВнешнееСобытие).
// Возвращает структуру: Успех, Текст, Режим (Native|Stub).
//
Функция НачатьНативныйВход() Экспорт
	
	Результат = Новый Структура("Успех, Текст, Режим", Ложь, "", "Stub");
	
	Если Не КомпонентаПодключена() Тогда
		
		Если Не ПодключитьКомпоненту() Тогда
			
			Результат.Текст =
				"Нативный вход Google доступен после сборки мобильного приложения "
				+ "с внешней компонентой WalletGoogleSignIn. "
				+ "См. docs/mobile/GOOGLE_SIGNIN_КОМПОНЕНТА.md";
			Возврат Результат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		
		Компонента = Новый (ИмяОбъектаКомпоненты());
		Компонента.SignIn();
		
		Результат.Успех = Истина;
		Результат.Режим = "Native";
		Результат.Текст = "Открыт системный выбор аккаунта Google…";
		
	Исключение
		
		Результат.Текст = "Не удалось открыть выбор аккаунта Google. Проверьте сборку компоненты.";
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Выход из Google-аккаунта на стороне Android (очистка сессии Sign-In).
//
Функция ВыйтиНативно() Экспорт
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	
	Если Не КомпонентаПодключена() Тогда
		
		Результат.Успех = Истина;
		Результат.Текст = "Компонента не загружена — локальные токены очищаются в 1С.";
		Возврат Результат;
		
	КонецЕсли;
	
	Попытка
		
		Компонента = Новый (ИмяОбъектаКомпоненты());
		Компонента.SignOut();
		Результат.Успех = Истина;
		Результат.Текст = "Сессия Google на устройстве завершена.";
		
	Исключение
		
		Результат.Текст = "Не удалось выполнить SignOut в компоненте.";
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Обработчик внешнего события компоненты. Вызывать из модуля приложения / формы.
// Ожидаемые события: GoogleSignInSuccess | GoogleSignInCancel | GoogleSignInError
// Данные Success — JSON: email, accessToken, refreshToken, expiresIn
//
Функция ОбработатьВнешнееСобытие(Источник, Событие, Данные) Экспорт
	
	Результат = Новый Структура("Обработано, Успех, Текст, Email", Ложь, Ложь, "", "");
	
	Если СтрНайти(ВРег(Строка(Источник)), "GOOGLE") = 0
		И СтрНайти(ВРег(Строка(Событие)), "GOOGLESIGNIN") = 0 Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Обработано = Истина;
	ИмяСобытия = ВРег(Строка(Событие));
	
	Если ИмяСобытия = "GOOGLESIGNINSUCCESS" Или ИмяСобытия = "SUCCESS" Тогда
		
		ДанныеВхода = РазобратьJSONВхода(Данные);
		
		Если ДанныеВхода = Неопределено Или Не ЗначениеЗаполнено(ДанныеВхода.email) Тогда
			
			Результат.Текст = "Google Sign-In не вернул email.";
			Возврат Результат;
			
		КонецЕсли;
		
		ОбщийМодульСервер_РезервноеКопирование.СохранитьРезультатНативногоВхода(
			ДанныеВхода.email,
			?(ДанныеВхода.Свойство("accessToken"), ДанныеВхода.accessToken, ""),
			?(ДанныеВхода.Свойство("refreshToken"), ДанныеВхода.refreshToken, ""),
			?(ДанныеВхода.Свойство("expiresIn"), ДанныеВхода.expiresIn, 3600));
		
		Результат.Успех = Истина;
		Результат.Email = ДанныеВхода.email;
		Результат.Текст = "Google-аккаунт подключён: " + ДанныеВхода.email;
		
	ИначеЕсли ИмяСобытия = "GOOGLESIGNINCANCEL" Или ИмяСобытия = "CANCEL" Тогда
		
		Результат.Текст = "Выбор аккаунта Google отменён.";
		
	Иначе
		
		Результат.Текст = "Ошибка Google Sign-In: " + Строка(Данные);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомпонентаПодключена()
	
	Попытка
		
		Компонента = Новый (ИмяОбъектаКомпоненты());
		Возврат Компонента <> Неопределено;
		
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции

Функция ПодключитьКомпоненту()
	
	Попытка
		
		// После добавления макета ОбщийМакет.WalletGoogleSignIn в конфигурацию:
		// Возврат ПодключитьВнешнююКомпоненту(ИмяМакетаКомпоненты());
		// Пока макета нет — всегда Ложь.
		Возврат Ложь;
		
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции

Функция РазобратьJSONВхода(Данные)
	
	ТекстJSON = Строка(Данные);
	
	Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Результат = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Возврат Результат;
		
	Исключение
		
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

#КонецОбласти
