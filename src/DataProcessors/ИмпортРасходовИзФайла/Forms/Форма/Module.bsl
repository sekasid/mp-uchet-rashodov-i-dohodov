Функция СоздатьДокументРасхода(СтрокаДанных, Счет, Валюта, КэшКатегорий, КатегорияПрочие, ОписаниеОшибки)
	
	Если Не ЗначениеЗаполнено(СтрокаДанных.Дата) Тогда
		
		ОписаниеОшибки = "не удалось разобрать дату.";
		Возврат Ложь;
		
	КонецЕсли;
	
	Если СтрокаДанных.Сумма <= 0 Тогда
		
		ОписаниеОшибки = "сумма должна быть больше нуля.";
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаДанных.ВидПлатежа) Тогда
		
		ОписаниеОшибки = "не указан вид платежа.";
		Возврат Ложь;
		
	КонецЕсли;
	
	РезультатКатегории = НайтиКатегориюПоВидуПлатежа(СтрокаДанных.ВидПлатежа, КэшКатегорий, КатегорияПрочие);
	
	ДокументОбъект = Документы.Расход.СоздатьДокумент();
	ДокументОбъект.Дата = СтрокаДанных.Дата;
	ДокументОбъект.Счет = Счет;
	ДокументОбъект.Валюта = Валюта;
	ДокументОбъект.КатегорияРасхода = РезультатКатегории.Категория;
	ДокументОбъект.Сумма = СтрокаДанных.Сумма;
	ДокументОбъект.Комментарий = ОбрезатьКомментарий(РезультатКатегории.Комментарий);
	
	// Ошибки проведения по строкам импорта не должны останавливать весь файл.
	Попытка
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение
		
		ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиКатегориюПоВидуПлатежа(ВидПлатежа, КэшКатегорий, КатегорияПрочие)
	
	Результат = Новый Структура("Категория, Комментарий", КатегорияПрочие, "");
	Текст = СокрЛП(ВидПлатежа);
	База = Текст;
	Уточнение = "";
	
	РазобратьБазуИУточнение(Текст, База, Уточнение);
	
	// «Разное (…)» / «Прочее (…)» — сначала ищем категорию из скобок в папке «Прочее».
	Если ЭтоБазаПрочее(База) Тогда
		
		Если ЗначениеЗаполнено(Уточнение) Тогда
			
			Категория = НайтиВПапкеПрочее(КэшКатегорий, Уточнение);
			
			Если Не ЗначениеЗаполнено(Категория) Тогда
				
				Категория = НайтиПоСинонимуИлиИмени(КэшКатегорий, Уточнение);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Категория) Тогда
				
				Результат.Категория = Категория;
				
				Если НРег(Строка(Категория)) <> НРег(Уточнение) Тогда
					
					Результат.Комментарий = Уточнение;
					
				КонецЕсли;
				
			Иначе
				
				Результат.Категория = КатегорияПрочие;
				Результат.Комментарий = Уточнение;
				
			КонецЕсли;
			
		Иначе
			
			Результат.Категория = КатегорияПрочие;
			
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Категория = НайтиВКэше(КэшКатегорий, Текст);
	
	Если Не ЗначениеЗаполнено(Категория) Тогда
		
		Категория = НайтиПоСинонимуИлиИмени(КэшКатегорий, Текст);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Категория) И ЗначениеЗаполнено(Уточнение) Тогда
		
		Категория = НайтиПоСинонимуИлиИмени(КэшКатегорий, Уточнение);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Категория) И ЗначениеЗаполнено(База) Тогда
		
		Категория = НайтиПоСинонимуИлиИмени(КэшКатегорий, База);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Категория) Тогда
		
		Категория = НайтиПоВхождению(КэшКатегорий, Текст);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Категория) Тогда
		
		Результат.Категория = Категория;
		
		Если ЗначениеЗаполнено(Уточнение) И НРег(Строка(Категория)) <> НРег(Уточнение) Тогда
			
			Результат.Комментарий = Уточнение;
			
		ИначеЕсли НРег(Строка(Категория)) <> НРег(Текст) Тогда
			
			Результат.Комментарий = Текст;
			
		КонецЕсли;
		
	Иначе
		
		Результат.Категория = КатегорияПрочие;
		Результат.Комментарий = Текст;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура РазобратьБазуИУточнение(Текст, База, Уточнение)
	
	База = Текст;
	Уточнение = "";
	
	ПозицияСкобки = СтрНайти(Текст, "(");
	
	Если ПозицияСкобки > 0 Тогда
		
		База = СокрЛП(Лев(Текст, ПозицияСкобки - 1));
		Уточнение = СокрЛП(Сред(Текст, ПозицияСкобки + 1));
		
		Если Прав(Уточнение, 1) = ")" Тогда
			
			Уточнение = СокрЛП(Лев(Уточнение, СтрДлина(Уточнение) - 1));
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	// «Разное парковка» без скобок.
	Если СтрДлина(Текст) > 6 И НРег(Лев(Текст, 6)) = "разное" Тогда
		
		Хвост = СокрЛП(Сред(Текст, 7));
		
		Если ЗначениеЗаполнено(Хвост) Тогда
			
			База = "Разное";
			Уточнение = Хвост;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоБазаПрочее(База)
	
	Ключ = НРег(СокрЛП(База));
	
	Возврат Ключ = "разное"
		Или Ключ = "прочее"
		Или Ключ = "прочие"
		Или Ключ = "прочие расходы";
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиВПапкеПрочее(КэшКатегорий, Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		
		Возврат Справочники.КатегорииРасходов.ПустаяСсылка();
		
	КонецЕсли;
	
	Найденное = КэшКатегорий.ПоИмениВПрочем.Получить(Ключ);
	
	Если Найденное = Неопределено Тогда
		
		Возврат Справочники.КатегорииРасходов.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат Найденное;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоСинонимуИлиИмени(КэшКатегорий, Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	Категория = НайтиВКэше(КэшКатегорий, Ключ);
	
	Если ЗначениеЗаполнено(Категория) Тогда
		
		Возврат Категория;
		
	КонецЕсли;
	
	ИмяПоСинониму = КэшКатегорий.Синонимы.Получить(Ключ);
	
	Если ИмяПоСинониму = Неопределено Тогда
		
		Возврат Справочники.КатегорииРасходов.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат НайтиВКэше(КэшКатегорий, ИмяПоСинониму);
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиВКэше(КэшКатегорий, Текст)
	
	Ключ = НРег(СокрЛП(Текст));
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		
		Возврат Справочники.КатегорииРасходов.ПустаяСсылка();
		
	КонецЕсли;
	
	Найденное = КэшКатегорий.ПоИмени.Получить(Ключ);
	
	Если Найденное = Неопределено Тогда
		
		Возврат Справочники.КатегорииРасходов.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат Найденное;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоВхождению(КэшКатегорий, Текст)
	
	КлючТекста = НРег(СокрЛП(Текст));
	ЛучшаяСсылка = Справочники.КатегорииРасходов.ПустаяСсылка();
	ЛучшаяДлина = 0;
	
	Для Каждого Элемент Из КэшКатегорий.Список Цикл
		
		Если СтрДлина(Элемент.Ключ) < 3 Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если СтрНайти(КлючТекста, Элемент.Ключ) = 0 Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если СтрДлина(Элемент.Ключ) > ЛучшаяДлина Тогда
			
			ЛучшаяДлина = СтрДлина(Элемент.Ключ);
			ЛучшаяСсылка = Элемент.Ссылка;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЛучшаяСсылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОбрезатьКомментарий(Текст)
	
	Значение = СокрЛП(Текст);
	
	Если СтрДлина(Значение) > 150 Тогда
		
		Возврат Лев(Значение, 150);
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

