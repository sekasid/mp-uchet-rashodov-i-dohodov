Функция КэшКатегорийРасходов()
	
	Кэш = Новый Структура;
	Кэш.Вставить("ПоИмени", Новый Соответствие);
	Кэш.Вставить("ПоИмениВПрочем", Новый Соответствие);
	Кэш.Вставить("Список", Новый Массив);
	Кэш.Вставить("Синонимы", СинонимыВидовПлатежа());
	Кэш.Вставить("ГруппаПрочее", Справочники.КатегорииРасходов.Прочее);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Категории.Ссылка КАК Ссылка,
	|	Категории.Наименование КАК Наименование,
	|	Категории.Родитель КАК Родитель
	|ИЗ
	|	Справочник.КатегорииРасходов КАК Категории
	|ГДЕ
	|	НЕ Категории.ЭтоГруппа
	|	И НЕ Категории.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Ключ = НРег(СокрЛП(Выборка.Наименование));
		Кэш.ПоИмени.Вставить(Ключ, Выборка.Ссылка);
		
		Элемент = Новый Структура("Ссылка, Наименование, Ключ", Выборка.Ссылка, Выборка.Наименование, Ключ);
		Кэш.Список.Добавить(Элемент);
		
		Если ЗначениеЗаполнено(Кэш.ГруппаПрочее) И Выборка.Родитель = Кэш.ГруппаПрочее Тогда
			
			Кэш.ПоИмениВПрочем.Вставить(Ключ, Выборка.Ссылка);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Кэш;
	
КонецФункции

